    "Rediscover photos taken on this day in past years.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temukan kembali foto yang diambil pada hari ini di tahun-tahun sebelumnya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد اكتشاف الصور الملتقطة في هذا اليوم خلال السنوات الماضية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগের বছরগুলোতে এই দিনে তোলা ছবি আবার খুঁজে দেখুন।"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преоткрийте снимки, направени на този ден през минали години."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Redescobreix les fotos fetes aquest mateix dia en anys anteriors."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno otkrijte fotografije snimljene na današnji dan prethodnih godina."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu objevte fotky pořízené v tento den v minulých letech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genopdag fotos taget på denne dag i tidligere år."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herontdek foto's die op deze dag in eerdere jaren zijn gemaakt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löydä uudelleen aiempina vuosina tänä päivänä otetut kuvat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redécouvrez les photos prises à cette date les années précédentes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke Fotos wieder, die an diesem Tag in früheren Jahren aufgenommen wurden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανακαλύψτε ξανά φωτογραφίες που τραβήχτηκαν αυτή την ημέρα προηγούμενων ετών."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גלו מחדש תמונות שצולמו ביום הזה בשנים קודמות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले वर्षों में आज के दिन ली गई फ़ोटो फिर से खोजें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fedezze fel újra a korábbi évek ezen a napján készült fotókat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscopri le foto scattate in questo giorno negli anni passati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の同じ日に撮影した写真をもう一度見つけましょう。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен жылдардағы осы күні түсірілген фотосуреттерді қайта табыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난해 같은 날에 촬영한 사진을 다시 만나보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iš naujo atraskite ankstesniais metais šią dieną padarytas nuotraukas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Temui semula foto yang diambil pada hari ini pada tahun-tahun lalu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenoppdag bilder som ble tatt på denne dagen i tidligere år."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس‌های گرفته‌شده در چنین روزی در سال‌های گذشته را دوباره ببینید."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkryj ponownie zdjęcia wykonane tego dnia w poprzednich latach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Redescubra fotos tiradas neste dia em anos anteriores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redescoperiți fotografiile realizate în această zi în anii trecuți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вспомните фотографии, сделанные в этот день в прошлые годы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重温往年同一天拍摄的照片。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu objavte fotografie vytvorené v tento deň v minulých rokoch."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno odkrijte fotografije, posnete na ta dan v preteklih letih."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redescubre las fotos tomadas en este día de años anteriores."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återupptäck foton som togs den här dagen tidigare år."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นพบรูปภาพที่ถ่ายในวันนี้เมื่อปีก่อน ๆ อีกครั้ง"
          }
