    "Choose an album to shuffle. Favorites is used when no album is selected.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih album untuk diputar acak. Favorit digunakan jika tidak ada album yang dipilih."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ألبومًا للتشغيل العشوائي. تُستخدم المفضلة عند عدم تحديد ألبوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এলোমেলোভাবে দেখার জন্য একটি অ্যালবাম বেছে নিন। কোনো অ্যালবাম না বাছলে পছন্দেরগুলো ব্যবহার করা হবে।"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете албум за разбъркване. Когато няма избран албум, се използват „Любими“."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria un àlbum per reproduir-lo aleatòriament. Si no en selecciones cap, s'utilitzen els Favorits."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite album za nasumičnu reprodukciju. Ako album nije odabran, koriste se Favoriti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte album pro náhodné střídání. Pokud žádné album nevyberete, použijí se Oblíbené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et album, der skal blandes. Favoritter bruges, når der ikke er valgt et album."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een album om willekeurig weer te geven. Favorieten wordt gebruikt als er geen album is geselecteerd."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse satunnaisesti vaihdettava albumi. Jos albumia ei ole valittu, käytetään Suosikit-albumia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un album à afficher aléatoirement. Favoris est utilisé si aucun album n’est sélectionné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Album für die zufällige Anzeige. Wenn kein Album ausgewählt ist, werden Favoriten verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ένα άλμπουμ για τυχαία εναλλαγή. Αν δεν επιλεγεί άλμπουμ, χρησιμοποιούνται τα Αγαπημένα."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו אלבום להצגה אקראית. אם לא נבחר אלבום, ייעשה שימוש במועדפים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यादृच्छिक रूप से दिखाने के लिए एल्बम चुनें। कोई एल्बम न चुने जाने पर पसंदीदा का उपयोग होता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon albumot a véletlenszerű megjelenítéshez. Ha nincs kiválasztva album, a Kedvencek lesz használva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un album da mostrare in ordine casuale. Se non selezioni alcun album, verranno usati i Preferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランダム表示するアルバムを選択してください。アルバムを選択しない場合は「お気に入り」が使用されます。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кездейсоқ көрсету үшін альбом таңдаңыз. Альбом таңдалмаса, Таңдаулылар пайдаланылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무작위로 표시할 앨범을 선택하세요. 앨범을 선택하지 않으면 즐겨찾기가 사용됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite albumą, kurį norite maišyti. Jei albumas nepasirinktas, naudojami Mėgstamiausi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih album untuk dikocok. Kegemaran digunakan apabila tiada album dipilih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et album som skal vises tilfeldig. Favoritter brukes når ingen album er valgt."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک آلبوم برای نمایش تصادفی انتخاب کنید. اگر آلبومی انتخاب نشود، علاقه‌مندی‌ها استفاده می‌شود."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz album do losowego wyświetlania. Gdy nie wybrano albumu, używane są Ulubione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um álbum para alternar. Os Favoritos são utilizados quando nenhum álbum está selecionado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți un album de afișat aleatoriu. Se utilizează Favorite dacă nu este selectat niciun album."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите альбом для случайного показа. Если альбом не выбран, используются «Избранные»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个相册进行随机展示。未选择相册时将使用“个人收藏”。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte album na náhodné zobrazovanie. Ak nie je vybraný žiadny album, použijú sa Obľúbené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite album za naključno prikazovanje. Če ni izbran noben album, se uporabi Priljubljeno."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un álbum para mostrarlo aleatoriamente. Si no seleccionas ninguno, se utilizará Favoritos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett album för slumpvis visning. Favoriter används när inget album har valts."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกอัลบั้มเพื่อแสดงแบบสุ่ม หากไม่ได้เลือกอัลบั้ม ระบบจะใช้รายการโปรด"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要隨機顯示的相簿。未選取相簿時將使用「喜好項目」。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karıştırmak için bir albüm seçin. Albüm seçilmezse Favoriler kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть альбом для перемішування. Якщо альбом не вибрано, використовуються «Улюблені»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn album để xáo trộn. Mục ưa thích sẽ được dùng khi không chọn album nào."
          }
        }
      }
    },
    "Keep a favorite album on your Home Screen.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan album favorit di Layar Utama Anda."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بألبوم مفضل على شاشتك الرئيسية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার হোম স্ক্রিনে একটি পছন্দের অ্যালবাম রাখুন।"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазете любим албум на началния екран."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva un àlbum favorit a la pantalla d'inici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržite omiljeni album na početnom zaslonu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mějte oblíbené album na ploše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold et favoritalbum på din hjemmeskærm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar een favoriet album op je beginscherm."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä suosikkialbumi Koti-valikossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez un album favori sur votre écran d’accueil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte ein Lieblingsalbum auf deinem Home-Bildschirm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρήστε ένα αγαπημένο άλμπουμ στην Αρχική οθόνη."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו אלבום מועדף במסך הבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने होम स्क्रीन पर पसंदीदा एल्बम रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartson egy kedvenc albumot a Főképernyőn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni un album preferito sulla schermata Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りのアルバムをホーム画面に表示します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдаулы альбомды Басты экранда сақтаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾는 앨범을 홈 화면에 유지하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laikykite mėgstamą albumą pradžios ekrane."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan album kegemaran pada Skrin Utama anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha et favorittalbum på Hjem-skjermen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک آلبوم دلخواه را در صفحه اصلی نگه دارید."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieść ulubiony album na ekranie początkowym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um álbum favorito no ecrã principal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrați un album favorit pe ecranul principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разместите избранный альбом на экране «Домой»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主屏幕上保留一个喜爱的相册。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechajte obľúbený album na ploche."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohranite priljubljeni album na domačem zaslonu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un álbum favorito en la pantalla de inicio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll ett favoritalbum på hemskärmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บอัลบั้มโปรดไว้บนหน้าจอโฮม"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在主畫面上保留一個喜愛的相簿。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori bir albümü Ana Ekranınızda tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігайте улюблений альбом на Початковому екрані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ một album yêu thích trên Màn hình chính."
          }
        }
      }
    },
