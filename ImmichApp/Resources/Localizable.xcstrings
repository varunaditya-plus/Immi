        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Альбомдарды таңдап, автоматты сақтық көшірмені қосу үшін «Фотосуреттердің сақтық көшірмесін жасау» бөлімін ашыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'사진 백업'을 열어 앨범을 선택하고 자동 백업을 켜세요."
