    "No items older than the cutoff have verified matching server copies outside your keep rules." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No items older than the cutoff have verified matching server copies outside your keep rules."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد عناصر أقدم من التاريخ المحدد، وغير مشمولة بقواعد الاحتفاظ لديك، لها نسخ مطابقة ومتحقق منها على الخادم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никакви елементи, по-стари от прекъсването, нямат проверени съответстващи сървърни копия извън вашите правила за запазване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নির্ধারিত তারিখের আগের এবং আপনার রেখে দেওয়ার নিয়মের বাইরে থাকা কোনো আইটেমের যাচাই করা মিলযুক্ত সার্ভার কপি পাওয়া যায়নি।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap element anterior al tall no ha verificat còpies del servidor coincidents fora de les vostres regles de manteniment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné položky starší než limit neověřily odpovídající kopie serveru mimo vaše pravidla zachování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen elementer, der er ældre end cutoff, har verificerede matchende serverkopier uden for dine keep-regler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Elemente, die älter als der Cutoff sind, verfügen über verifizierte übereinstimmende Serverkopien außerhalb Ihrer Aufbewahrungsregeln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν στοιχεία παλαιότερα από την ημερομηνία ορίου, εκτός των κανόνων διατήρησης, με επαληθευμένα αντίστοιχα αντίγραφα στον διακομιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún elemento anterior al límite tiene copias de servidor coincidentes verificadas fuera de sus reglas de conservación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ موردی قدیمی‌تر از تاریخ تعیین‌شده و خارج از قوانین نگهداری شما، نسخهٔ سرورِ تأییدشده و مطابق ندارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitkään rajaa vanhemmat kohteet eivät ole vahvistaneet vastaavia palvelinkopioita säilytyssääntöjen ulkopuolella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun élément antérieur à la date limite et non protégé par vos règles de conservation ne possède de copie correspondante vérifiée sur le serveur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא נמצאו פריטים שקדמו לתאריך שנבחר, אינם נכללים בכללי השמירה שלך ויש להם עותקי שרת תואמים ומאומתים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनी गई तारीख से पुराने और आपके सुरक्षित रखने के नियमों से बाहर आने वाले किसी भी आइटम की मेल खाती सर्वर प्रति सत्यापित नहीं हुई है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijedna stavka starija od granične vrijednosti nema potvrđene podudarne kopije poslužitelja izvan vaših pravila čuvanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vágási határnál régebbi elemek nem ellenőrizték a megőrzési szabályokon kívül eső, megfelelő szerverpéldányokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
