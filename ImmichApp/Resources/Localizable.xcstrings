    "Waiting for Wi-Fi. Allow cellular data in Backup Options to continue now." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for Wi-Fi. Allow cellular data in Backup Options to continue now."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في انتظار خدمة الواي فاي. السماح للبيانات الخلوية في خيارات النسخ الاحتياطي بالمتابعة الآن."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изчакване на Wi-Fi. Разрешете клетъчните данни в Опции за архивиране, за да продължите сега."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi এর জন্য অপেক্ষা করা হচ্ছে। ব্যাকআপ বিকল্পগুলিতে সেলুলার ডেটাকে এখনই চালিয়ে যাওয়ার অনুমতি দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperant el Wi-Fi. Permet que les dades mòbils a Opcions de còpia de seguretat continuïn ara."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čekání na Wi-Fi. Chcete-li nyní pokračovat, povolte mobilní data v možnostech zálohování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på Wi-Fi. Tillad mobildata i sikkerhedskopieringsindstillinger at fortsætte nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten auf WLAN. Lassen Sie in den Sicherungsoptionen zu, dass Mobilfunkdaten jetzt fortfahren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναμονή για Wi-Fi. Επιτρέψτε στα δεδομένα κινητής τηλεφωνίας στις Επιλογές δημιουργίας αντιγράφων ασφαλείας να συνεχίσουν τώρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando wifi. Permita que los datos móviles en Opciones de copia de seguridad continúen ahora."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در انتظار Wi-Fi. به داده‌های تلفن همراه در گزینه‌های پشتیبان‌گیری اجازه داده می‌شود تا اکنون ادامه پیدا کنند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odotetaan Wi-Fi-yhteyttä. Salli mobiilidatan jatkaa nyt Varmuuskopiointiasetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente du Wi-Fi. Autorisez les données cellulaires dans les options de sauvegarde à continuer maintenant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחכה ל-Wi-Fi. אפשר לנתונים סלולריים באפשרויות הגיבוי להמשיך כעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वाई-फ़ाई की प्रतीक्षा की जा रही है. बैकअप विकल्पों में सेल्यूलर डेटा को अभी जारी रखने की अनुमति दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čekanje na Wi-Fi. Dopustite mobilnim podacima u opcijama sigurnosne kopije da biste sada nastavili."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Várakozás a Wi-Fi-re. A Biztonsági mentési beállításokban engedélyezze a mobiladat-kapcsolat folytatását."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu Wi-Fi. Izinkan data seluler di Opsi Cadangan untuk melanjutkan sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa del Wi-Fi. Consenti ai dati cellulare nelle Opzioni di backup di continuare adesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fiを待っています。バックアップ オプションで携帯電話データの続行を今すぐ許可します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi күтуде. Сақтық көшірме опцияларында ұялы деректерге қазір жалғастыруға рұқсат беріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi를 기다리는 중입니다. 지금 백업 옵션에서 셀룰러 데이터를 계속 허용하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laukiama Wi-Fi. Leiskite mobiliesiems duomenims tęsti dabar skiltyje Atsarginės kopijos parinktys."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu Wi-Fi. Benarkan data selular dalam Pilihan Sandaran diteruskan sekarang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på Wi-Fi. Tillat mobildata i sikkerhetskopieringsalternativer å fortsette nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachten op wifi. Sta mobiele data in Back-upopties nu toe om door te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czekam na Wi-Fi. Zezwól na kontynuację transmisji danych komórkowych w Opcjach kopii zapasowej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando por Wi-Fi. Permita que os dados do celular nas opções de backup continuem agora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se așteaptă Wi-Fi. Permiteți ca datele mobile din Opțiunile de rezervă să continue acum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ждем Wi-Fi. Разрешите сотовые данные в параметрах резервного копирования, чтобы продолжить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čaká sa na Wi-Fi. Povoľte mobilné dáta v možnostiach zálohovania, aby ste mohli pokračovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čakanje na Wi-Fi. Za nadaljevanje omogočite mobilne podatke v možnostih varnostnega kopiranja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väntar på Wi-Fi. Tillåt att mobildata i säkerhetskopieringsalternativen fortsätter nu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำลังรอ Wi-Fi อนุญาตให้ใช้ข้อมูลเครือข่ายโทรศัพท์ในตัวเลือกการสำรองข้อมูลเพื่อดำเนินการต่อทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi bekleniyor. Şimdi Yedekleme Seçenekleri'nde hücresel verilerin devam etmesine izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очікування Wi-Fi. Дозвольте мобільні дані в параметрах резервного копіювання, щоб продовжити зараз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
