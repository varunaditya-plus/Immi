    "All eligible items are already protected by your current keep rules, or nothing older than the cutoff is backed up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جميع العناصر المؤهلة محمية بالفعل بقواعد الاحتفاظ الحالية، أو لا توجد عناصر أقدم من تاريخ الحد تم نسخها احتياطيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всички допустими елементи вече са защитени от текущите правила за запазване или няма архивирани елементи, по-стари от крайната дата."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যোগ্য সব আইটেম বর্তমান সংরক্ষণ নিয়মে ইতিমধ্যে সুরক্ষিত, অথবা সীমার তারিখের চেয়ে পুরোনো কিছুই ব্যাকআপ করা নেই।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tots els elements aptes ja estan protegits per les regles de conservació actuals, o no hi ha cap element anterior a la data límit amb còpia de seguretat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny vhodné položky již chrání aktuální pravidla uchovávání nebo nejsou zálohovány žádné položky starší než zvolené datum."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle relevante emner er allerede beskyttet af dine nuværende regler for bevaring, eller også er intet ældre end skæringsdatoen sikkerhedskopieret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle geeigneten Elemente sind bereits durch deine aktuellen Aufbewahrungsregeln geschützt oder es wurden keine Elemente vor dem Stichtag gesichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα τα κατάλληλα στοιχεία προστατεύονται ήδη από τους τρέχοντες κανόνες διατήρησης ή δεν έχει αντιγραφεί τίποτα παλαιότερο από την ημερομηνία αποκοπής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los elementos aptos ya están protegidos por las reglas de conservación actuales, o no hay copias de seguridad anteriores a la fecha límite."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه موارد واجد شرایط از قبل با قوانین نگهداری فعلی محافظت می‌شوند، یا هیچ مورد قدیمی‌تر از تاریخ تعیین‌شده پشتیبان‌گیری نشده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyiset säilytyssääntösi suojaavat jo kaikkia soveltuvia kohteita, tai valittua päivää vanhempia varmuuskopioituja kohteita ei ole."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les éléments éligibles sont déjà protégés par vos règles de conservation actuelles, ou aucun élément antérieur à la date limite n’est sauvegardé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל הפריטים המתאימים כבר מוגנים על ידי כללי השמירה הנוכחיים, או שלא גובה דבר הישן מתאריך הסף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी योग्य आइटम आपके मौजूदा रखने के नियमों से पहले ही सुरक्षित हैं, या अंतिम तिथि से पुराना कुछ भी बैकअप नहीं किया गया है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve odgovarajuće stavke već su zaštićene trenutačnim pravilima čuvanja ili nema sigurnosno kopiranih stavki starijih od graničnog datuma."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden megfelelő elemet védenek a jelenlegi megőrzési szabályok, vagy nincs a határidőnél régebbi, biztonsági mentéssel rendelkező elem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua item yang memenuhi syarat sudah dilindungi oleh aturan penyimpanan saat ini, atau tidak ada item sebelum batas waktu yang telah dicadangkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti gli elementi idonei sono già protetti dalle regole di conservazione attuali oppure nessun elemento precedente alla data limite dispone di un backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象となるすべての項目は現在の保持ルールですでに保護されているか、基準日より古い項目がバックアップされていません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Барлық жарамды элементтер ағымдағы сақтау ережелерімен қорғалған немесе шекті күннен ескі сақтық көшірмесі бар элемент жоқ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 항목이 모두 현재 보관 규칙으로 이미 보호되어 있거나, 기준 날짜보다 오래된 항목 중 백업된 항목이 없습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visi tinkami elementai jau apsaugoti dabartinėmis saugojimo taisyklėmis arba nėra atsarginę kopiją turinčių elementų, senesnių už pasirinktą datą."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua item yang layak sudah dilindungi oleh peraturan simpan semasa anda, atau tiada item yang lebih lama daripada tarikh tamat mempunyai sandaran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle kvalifiserte elementer er allerede beskyttet av gjeldende oppbevaringsregler, eller ingen sikkerhetskopierte elementer er eldre enn grensedatoen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle geschikte items worden al beschermd door je huidige bewaarregels, of er is niets ouder dan de grensdatum geback-upt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie kwalifikujące się elementy są już chronione przez bieżące reguły przechowywania albo żaden element starszy niż data graniczna nie ma kopii zapasowej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os itens elegíveis já estão protegidos pelas regras de conservação atuais ou não há cópias de segurança anteriores à data-limite."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate elementele eligibile sunt deja protejate de regulile actuale de păstrare sau nu există copii de siguranță mai vechi decât data-limită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все подходящие элементы уже защищены текущими правилами хранения либо в резервной копии нет элементов старше выбранной даты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky vhodné položky sú už chránené aktuálnymi pravidlami ponechania alebo záloha neobsahuje nič staršie než hraničný dátum."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsi primerni elementi so že zaščiteni s trenutnimi pravili ohranjanja ali pa varnostna kopija ne vsebuje ničesar, kar je starejše od mejnega datuma."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla kvalificerade objekt skyddas redan av de aktuella reglerna för att behålla, eller så finns inget äldre än brytdatumet i säkerhetskopian."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการที่เข้าเกณฑ์ทั้งหมดได้รับการปกป้องด้วยกฎการเก็บปัจจุบันแล้ว หรือไม่มีข้อมูลสำรองที่เก่ากว่าวันที่กำหนด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygun öğelerin tümü mevcut saklama kurallarınızla zaten korunuyor veya sınır tarihinden daha eski hiçbir şey yedeklenmemiş."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі придатні елементи вже захищені поточними правилами зберігання або резервних копій елементів, старіших за граничну дату, немає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả mục đủ điều kiện đã được bảo vệ theo quy tắc giữ lại hiện tại, hoặc không có mục nào cũ hơn mốc thời gian đã được sao lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有符合条件的项目均已受当前保留规则保护，或备份中没有早于截止日期的项目。"
