    "Albums you share or that others share with you will appear here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albums you share or that others share with you will appear here."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر هنا الألبومات التي تشاركها أو التي يشاركها الآخرون معك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Албумите, които споделяте или които други споделят с вас, ще се показват тук."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যে অ্যালবামগুলি ভাগ করেন বা অন্যরা আপনার সাথে ভাগ করে তা এখানে প্রদর্শিত হবে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els àlbums que compartiu o que altres comparteixin amb vosaltres apareixeran aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde se zobrazí alba, která sdílíte nebo která s vámi sdílejí ostatní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album, du deler, eller som andre deler med dig, vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier werden Alben angezeigt, die Sie oder andere mit Ihnen teilen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα άλμπουμ που μοιράζεστε ή που άλλοι μοιράζονται μαζί σας θα εμφανίζονται εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los álbumes que compartes o que otras personas comparten contigo aparecerán aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آلبوم هایی که به اشتراک می گذارید یا دیگران با شما به اشتراک می گذارند در اینجا ظاهر می شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumit, jotka jaat tai jotka muut jakavat kanssasi, näkyvät täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les albums que vous partagez ou que d'autres partagent avec vous apparaîtront ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אלבומים שאתה משתף או שאחרים משתפים איתך יופיעו כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके द्वारा साझा किए गए या दूसरों द्वारा आपके साथ साझा किए गए एल्बम यहां दिखाई देंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovdje će se pojaviti albumi koje dijelite ili koje drugi dijele s vama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itt jelennek meg azok az albumok, amelyeket Ön vagy mások osztanak meg veled."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album yang Anda bagikan atau yang dibagikan orang lain kepada Anda akan muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli album che condividi o che altri condividono con te verranno visualizzati qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたが共有しているアルバム、または他の人があなたと共有しているアルバムがここに表示されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сіз бөліскен немесе басқалар сізбен бөлісетін альбомдар осы жерде пайда болады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하가 공유하거나 다른 사람이 귀하와 공유한 앨범이 여기에 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumai, kuriuos bendrinate arba kuriuos kiti bendrina su jumis, bus rodomi čia."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album yang anda kongsi atau yang orang lain kongsi dengan anda akan dipaparkan di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album du deler eller som andre deler med deg, vises her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albums die u deelt of die anderen met u delen, worden hier weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumy, które udostępniasz lub które udostępniają Ci inni, pojawią się tutaj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os álbuns que você compartilha ou que outras pessoas compartilham com você aparecerão aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumele pe care le distribuiți sau pe care alții vi le distribuie vor apărea aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появятся альбомы, которыми вы поделились или которыми с вами поделились другие."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sa zobrazia albumy, ktoré zdieľate alebo ktoré s vami zdieľajú iní."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumi, ki jih daste v skupno rabo ali jih drugi delijo z vami, bodo prikazani tukaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album du delar eller som andra delar med dig kommer att visas här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัลบั้มที่คุณแชร์หรือที่ผู้อื่นแชร์กับคุณจะปรากฏที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaştığınız veya başkalarının sizinle paylaştığı albümler burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тут відображатимуться альбоми, якими ви поділилися або якими з вами поділилися інші."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album bạn chia sẻ hoặc album được người khác chia sẻ với bạn sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您共享的或其他人与您共享的相册将显示在此处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您共享的或其他人與您共享的相簿將顯示在此。"
          }
        }
      }
    },
