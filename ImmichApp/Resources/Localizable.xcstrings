          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বয়ংক্রিয় ব্যাকআপ বন্ধ আছে। অনুরোধ করা আপলোডগুলি পুনরায় শুরু করতে ফটো অ্যাক্সেসের অনুমতি দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La còpia de seguretat automàtica està desactivada. Permet l'accés a Fotos per reprendre les càrregues sol·licitades."
          }
        },
        "cs" : {
          "stringUnit" : {
