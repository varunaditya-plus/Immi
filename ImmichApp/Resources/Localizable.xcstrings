          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρέθηκαν προσβάσιμες φωτογραφίες ή βίντεο στα επιλεγμένα άλμπουμ. Επιτρέψτε την πλήρη πρόσβαση στις Φωτογραφίες για να ελέγξετε τα υπόλοιπα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontraron fotos ni vídeos accesibles en los álbumes seleccionados. Permita el acceso completo a las fotos para comprobar el resto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
