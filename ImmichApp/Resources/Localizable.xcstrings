    "The photo is backed up, but its album could not be resolved. Album placement will retry." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The photo is backed up, but its album could not be resolved. Album placement will retry."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم نسخ الصورة احتياطيًا، لكن تعذر حل الألبوم الخاص بها. ستتم إعادة محاولة وضع الألبوم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимката е архивирана, но албумът й не може да бъде разрешен. Поставянето на албума ще бъде направено отново."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফটোটি ব্যাক আপ করা হয়েছে, কিন্তু এর অ্যালবামের সমাধান করা যায়নি৷ অ্যালবাম বসানো আবার চেষ্টা করা হবে."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha creat una còpia de seguretat de la foto, però no s'ha pogut resoldre el seu àlbum. Es tornarà a intentar la col·locació de l'àlbum."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotka je zálohovaná, ale její album se nepodařilo vyřešit. Umístění alba se zkusí znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billedet er sikkerhedskopieret, men dets album kunne ikke løses. Albumplacering vil prøve igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Foto wurde gesichert, aber sein Album konnte nicht aufgelöst werden. Die Platzierung des Albums wird erneut versucht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήθηκε αντίγραφο ασφαλείας της φωτογραφίας, αλλά δεν ήταν δυνατή η επίλυση του άλμπουμ της. Η τοποθέτηση άλμπουμ θα επαναληφθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto tiene una copia de seguridad, pero no se pudo resolver su álbum. Se volverá a intentar colocar el álbum."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عکس پشتیبان‌گیری شده است، اما آلبوم آن قابل حل نیست. قرار دادن آلبوم دوباره امتحان خواهد شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuva on varmuuskopioitu, mutta sen albumia ei voitu ratkaista. Albumin sijoittamista yritetään uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La photo est sauvegardée, mais son album n'a pas pu être résolu. Le placement de l'album va être réessayé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התמונה מגובה, אך לא ניתן היה לפתור את האלבום שלה. מיקום האלבום ינסה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोटो का बैकअप ले लिया गया है, लेकिन उसके एल्बम का समाधान नहीं किया जा सका. एल्बम प्लेसमेंट पुनः प्रयास किया जाएगा."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografija je sigurnosno kopirana, ali njezin album nije moguće riješiti. Pokušat će se ponovno postavljanje albuma."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fényképről biztonsági másolat készült, de az albumát nem sikerült feloldani. Az albumelhelyezés újra megpróbálkozik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto telah dicadangkan, namun albumnya tidak dapat diselesaikan. Penempatan album akan dicoba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
