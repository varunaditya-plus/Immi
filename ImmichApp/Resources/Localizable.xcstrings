        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Құрылғыдағы медиа элементтерін синхрондамас бұрын фотосуреттерге қол жеткізуге рұқсат беріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
