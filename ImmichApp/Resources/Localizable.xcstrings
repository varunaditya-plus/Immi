        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandaran automatik dimatikan. Muat naik dan pemindahan manual yang sedang dijalankan masih boleh selesai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk sikkerhetskopiering er av. Manuelle opplastinger og overføringer som allerede pågår, kan fortsatt fullføres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatische back-up staat uit. Handmatige uploads en overdrachten die al bezig zijn, kunnen nog steeds worden voltooid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatyczna kopia zapasowa jest wyłączona. Ręczne przesyłanie i transfery, które już trwają, mogą nadal zostać dokończone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O backup automático está desativado. Os uploads e transferências manuais já em andamento ainda podem ser concluídos."
