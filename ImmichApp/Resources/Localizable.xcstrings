    "Some uploads need attention. View Details to retry or remove them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some uploads need attention. View Details to retry or remove them."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعض التحميلات تحتاج إلى الاهتمام. عرض التفاصيل لإعادة المحاولة أو إزالتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Някои качвания изискват внимание. Вижте подробности, за да опитате отново или да ги премахнете."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিছু আপলোড মনোযোগ প্রয়োজন. পুনরায় চেষ্টা করতে বা অপসারণ করতে বিশদ দেখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunes càrregues necessiten atenció. Mostra els detalls per tornar-los a provar o eliminar-los."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některá nahrávání vyžadují pozornost. Zobrazit podrobnosti a zkusit to znovu nebo je odebrat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle uploads kræver opmærksomhed. Se detaljer for at prøve igen eller fjerne dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Uploads erfordern Aufmerksamkeit. Details anzeigen, um es erneut zu versuchen oder zu entfernen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορισμένες μεταφορτώσεις χρειάζονται προσοχή. Δείτε Λεπτομέρειες για να τις δοκιμάσετε ξανά ή να τις αφαιρέσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas cargas necesitan atención. Ver detalles para volver a intentarlo o eliminarlos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برخی از آپلودها نیاز به توجه دارند. مشاهده جزئیات برای امتحان مجدد یا حذف آنها."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotkut lataukset vaativat huomiota. Katso tiedot, jos haluat yrittää uudelleen tai poistaa ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains envois nécessitent votre attention. Consultez les détails pour réessayer ou les supprimer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה העלאות דורשות תשומת לב. הצג פרטים כדי לנסות שוב או להסיר אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ अपलोड पर ध्यान देने की आवश्यकता है. पुनः प्रयास करने या उन्हें हटाने के लिए विवरण देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neka učitavanja zahtijevaju pozornost. Pogledajte pojedinosti da biste pokušali ponovno ili ih uklonili."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyes feltöltések figyelmet igényelnek. Nézze meg a részleteket az újrapróbálkozáshoz vagy eltávolításhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa unggahan perlu mendapat perhatian. Lihat Detail untuk mencoba lagi atau menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni caricamenti richiedono attenzione. Visualizza i dettagli per riprovare o rimuoverli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のアップロードには注意が必要です。詳細を表示して再試行するか、削除してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кейбір жүктеп салуларға назар аудару қажет. Қайталап көру немесе жою үшін мәліметтерді қараңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 업로드에는 주의가 필요합니다. 세부정보를 확인하여 다시 시도하거나 삭제하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai kuriems įkėlimams reikia skirti dėmesio. Peržiūrėkite išsamią informaciją ir bandykite dar kartą arba pašalinkite."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesetengah muat naik memerlukan perhatian. Lihat Butiran untuk mencuba semula atau mengalih keluarnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen opplastinger trenger oppmerksomhet. Vis detaljer for å prøve på nytt eller fjerne dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige uploads hebben aandacht nodig. Bekijk details om ze opnieuw te proberen of te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre przesłane pliki wymagają uwagi. Wyświetl szczegóły, aby spróbować ponownie lub je usunąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns uploads precisam de atenção. Veja os detalhes para tentar novamente ou removê-los."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unele încărcări necesită atenție. Vedeți detalii pentru a reîncerca sau pentru a le elimina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые загрузки требуют внимания. Просмотрите сведения, чтобы повторить попытку или удалить их."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektoré nahrávania vyžadujú pozornosť. Zobrazte podrobnosti a skúste to znova alebo ich odstráňte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nekatera nalaganja zahtevajo pozornost. Oglejte si podrobnosti, da poskusite znova ali jih odstranite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa uppladdningar kräver uppmärksamhet. Visa detaljer för att försöka igen eller ta bort dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การอัปโหลดบางรายการจำเป็นต้องได้รับการดูแล ดูรายละเอียดเพื่อลองอีกครั้งหรือลบออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı yüklemelerin dikkat edilmesi gerekiyor. Yeniden denemek veya kaldırmak için Ayrıntıları Görüntüleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі завантаження потребують уваги. Перегляньте деталі, щоб повторити спробу або видалити їх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một số nội dung tải lên cần được chú ý. Xem chi tiết để thử lại hoặc loại bỏ chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些上传需要注意。查看详细信息以重试或删除它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些上傳要注意。查看詳細資訊以重試或刪除它們。"
          }
        }
      }
    },
