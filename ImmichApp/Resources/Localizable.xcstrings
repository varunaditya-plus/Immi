    "%@ items moved to Recently Deleted" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم نقل %@ عنصرًا إلى المحذوفة مؤخرًا"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ елемента са преместени в „Наскоро изтрити“"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@টি আইটেম সম্প্রতি মুছে ফেলা-তে সরানো হয়েছে"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'han mogut %@ elements a Eliminats recentment"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky (%@) byly přesunuty do Nedávno smazaných"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ emner flyttet til Slettet for nylig"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Elemente nach „Zuletzt gelöscht“ verschoben"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ στοιχεία μετακινήθηκαν στα Πρόσφατα διαγραμμένα"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ elementos movidos a Eliminado recientemente"
