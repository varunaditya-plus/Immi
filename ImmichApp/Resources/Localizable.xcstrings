          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ανανέωση εφαρμογών στο παρασκήνιο είναι απενεργοποιημένη. Ενεργοποιήστε το στις Ρυθμίσεις > Γενικά > Ανανέωση εφαρμογής στο παρασκήνιο."
          }
        },
        "es" : {
          "stringUnit" : {
