    "Your Immich session expired. Sign in again to resume backup." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية جلسة Immich. سجّل الدخول مرة أخرى لاستئناف النسخ الاحتياطي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашата Immich сесия изтече. Влезте отново, за да продължите архивирането."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার Immich সেশনের মেয়াদ শেষ হয়েছে। ব্যাকআপ আবার শুরু করতে পুনরায় সাইন ইন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessió d'Immich ha caducat. Torna a iniciar sessió per reprendre la còpia de seguretat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platnost relace Immich vypršela. Přihlaste se znovu a pokračujte v zálohování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Immich-session er udløbet. Log ind igen for at fortsætte sikkerhedskopieringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Immich-Sitzung ist abgelaufen. Melde dich erneut an, um die Sicherung fortzusetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η συνεδρία Immich έληξε. Συνδεθείτε ξανά για να συνεχιστεί η δημιουργία αντιγράφων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión de Immich ha caducado. Vuelve a iniciar sesión para reanudar la copia de seguridad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشست Immich شما منقضی شد. برای ادامه پشتیبان‌گیری دوباره وارد شوید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immich-istuntosi on vanhentunut. Jatka varmuuskopiointia kirjautumalla uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre session Immich a expiré. Reconnectez-vous pour reprendre la sauvegarde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פג תוקף הפעלת Immich. התחברו שוב כדי להמשיך את הגיבוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका Immich सेशन समाप्त हो गया। बैकअप फिर शुरू करने के लिए साइन इन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša Immich sesija je istekla. Ponovno se prijavite kako biste nastavili sigurnosno kopiranje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Immich-munkamenete lejárt. Jelentkezzen be újra a biztonsági mentés folytatásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi Immich Anda telah berakhir. Masuk lagi untuk melanjutkan pencadangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione Immich è scaduta. Accedi di nuovo per riprendere il backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immichセッションの有効期限が切れました。バックアップを再開するにはもう一度サインインしてください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immich сеансының мерзімі аяқталды. Сақтық көшірмені жалғастыру үшін қайта кіріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immich 세션이 만료되었습니다. 백업을 재개하려면 다시 로그인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų Immich seansas baigėsi. Prisijunkite dar kartą, kad tęstumėte atsarginių kopijų kūrimą."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi Immich anda telah tamat tempoh. Log masuk semula untuk menyambung sandaran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immich-økten din har utløpt. Logg på igjen for å fortsette sikkerhetskopieringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Immich-sessie is verlopen. Meld je opnieuw aan om de back-up te hervatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesja Immich wygasła. Zaloguj się ponownie, aby wznowić tworzenie kopii zapasowej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua sessão do Immich expirou. Inicie sessão novamente para retomar a cópia de segurança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiunea Immich a expirat. Autentificați-vă din nou pentru a relua copia de siguranță."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок действия сеанса Immich истек. Войдите снова, чтобы возобновить резервное копирование."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platnosť relácie Immich vypršala. Opätovným prihlásením pokračujte v zálohovaní."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seja Immich je potekla. Znova se prijavite, da nadaljujete varnostno kopiranje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Immich-session har gått ut. Logga in igen för att återuppta säkerhetskopieringen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชัน Immich ของคุณหมดอายุ เข้าสู่ระบบอีกครั้งเพื่อดำเนินการสำรองข้อมูลต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immich oturumunuzun süresi doldu. Yedeklemeye devam etmek için yeniden oturum açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термін дії сеансу Immich минув. Увійдіть знову, щоб продовжити резервне копіювання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên Immich của bạn đã hết hạn. Đăng nhập lại để tiếp tục sao lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 Immich 会话已过期。请重新登录以继续备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 Immich 連線階段已過期。請重新登入以繼續備份。"
          }
        }
      }
    },
    "Your locked folder is protected by a PIN." : {
