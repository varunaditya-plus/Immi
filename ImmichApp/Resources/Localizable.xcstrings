    "Checking copies and waiting for Photos…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checking copies and waiting for Photos…"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ التحقق من النسخ وانتظار الصور..."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяват се копията и се чакат снимки..."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কপি চেক করা হচ্ছে এবং ফটোর জন্য অপেক্ষা করা হচ্ছে..."
          }
        },
        "ca" : {
