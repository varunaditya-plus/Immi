    "iOS will ask for final confirmation. You can recover these items from Recently Deleted for a limited time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيطلب iOS تأكيدًا نهائيًا. يمكنك استرداد هذه العناصر من المحذوفة مؤخرًا لفترة محدودة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ще поиска окончателно потвърждение. Можете да възстановите тези елементи от „Наскоро изтрити“ за ограничен период."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS চূড়ান্ত নিশ্চিতকরণ চাইবে। সীমিত সময়ের মধ্যে আপনি সম্প্রতি মুছে ফেলা থেকে এই আইটেমগুলো পুনরুদ্ধার করতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS demanarà una confirmació final. Pots recuperar aquests elements d'Eliminats recentment durant un temps limitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS požádá o konečné potvrzení. Po omezenou dobu můžete tyto položky obnovit z Nedávno smazaných."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS beder om en endelig bekræftelse. Du kan gendanne disse emner fra Slettet for nylig i en begrænset periode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS bittet um eine abschließende Bestätigung. Du kannst diese Elemente für begrenzte Zeit aus „Zuletzt gelöscht“ wiederherstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iOS θα ζητήσει τελική επιβεβαίωση. Μπορείτε να ανακτήσετε αυτά τα στοιχεία από τα Πρόσφατα διαγραμμένα για περιορισμένο χρονικό διάστημα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS solicitará una confirmación final. Podrás recuperar estos elementos desde Eliminado recientemente durante un tiempo limitado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS تأیید نهایی را درخواست می‌کند. این موارد را برای مدت محدودی می‌توانید از «اخیراً حذف‌شده» بازیابی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pyytää lopullisen vahvistuksen. Voit palauttaa nämä kohteet Äskettäin poistetuista rajoitetun ajan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS demandera une confirmation finale. Vous pourrez récupérer ces éléments dans Supprimées récemment pendant une durée limitée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS יבקש אישור סופי. ניתן לשחזר את הפריטים האלה מתוך נמחקו לאחרונה למשך זמן מוגבל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS अंतिम पुष्टि माँगेगा। आप सीमित समय तक हाल ही में हटाए गए से इन आइटम को वापस पा सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS će zatražiti konačnu potvrdu. Ove stavke možete vratiti iz Nedavno obrisanog tijekom ograničenog vremena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iOS végső megerősítést kér. Ezek az elemek korlátozott ideig visszaállíthatók a Nemrég törölt albumból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS akan meminta konfirmasi terakhir. Anda dapat memulihkan item ini dari Baru Dihapus selama waktu terbatas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS chiederà una conferma finale. Per un periodo limitato, puoi recuperare questi elementi da Eliminati di recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSで最終確認が求められます。これらの項目は、一定期間「最近削除した項目」から復元できます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS соңғы растауды сұрайды. Бұл элементтерді шектеулі уақыт ішінде «Жуырда жойылғандар» бөлімінен қалпына келтіруге болады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS에서 최종 확인을 요청합니다. 일정 기간 동안 '최근 삭제된 항목'에서 이 항목을 복구할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS paprašys galutinio patvirtinimo. Ribotą laiką šiuos elementus galėsite atkurti iš „Neseniai ištrinti“."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS akan meminta pengesahan akhir. Anda boleh memulihkan item ini daripada Baru Dipadam untuk tempoh yang terhad."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ber om endelig bekreftelse. Du kan gjenopprette disse elementene fra Nylig slettet i en begrenset periode."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS vraagt om een laatste bevestiging. Je kunt deze items gedurende beperkte tijd herstellen vanuit Recent verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS poprosi o ostateczne potwierdzenie. Przez ograniczony czas możesz odzyskać te elementy z „Ostatnio usunięte”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS pedirá uma confirmação final. Pode recuperar estes itens de Apagados recentemente durante um período limitado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS va solicita o confirmare finală. Puteți recupera aceste elemente din Șterse recent pentru o perioadă limitată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS запросит окончательное подтверждение. В течение ограниченного времени эти элементы можно восстановить из альбома «Недавно удаленные»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS požiada o konečné potvrdenie. Obmedzený čas môžete tieto položky obnoviť z Nedávno vymazaných."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS bo zahteval končno potrditev. Te elemente lahko omejen čas obnovite iz Nedavno izbrisanega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ber om en slutlig bekräftelse. Du kan återställa objekten från Senast raderade under en begränsad tid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS จะขอการยืนยันครั้งสุดท้าย คุณสามารถกู้คืนรายการเหล่านี้จากที่เพิ่งลบล่าสุดได้ภายในระยะเวลาจำกัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS son onayı isteyecek. Bu öğeleri sınırlı bir süre boyunca Son Silinenler'den kurtarabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS попросить остаточне підтвердження. Протягом обмеженого часу ці елементи можна відновити з «Нещодавно видалені»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS sẽ yêu cầu xác nhận lần cuối. Bạn có thể khôi phục các mục này từ Đã xóa gần đây trong một khoảng thời gian giới hạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 将要求最终确认。在有限时间内，您可以从“最近删除”中恢复这些项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 將要求最終確認。在有限時間內，您可以從「最近刪除」中復原這些項目。"
          }
        }
      }
