    "Only photos and videos with verified matching server copies can be moved to Recently Deleted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only photos and videos with verified matching server copies can be moved to Recently Deleted."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن فقط نقل الصور ومقاطع الفيديو التي تحتوي على نسخ خادم متطابقة تم التحقق منها إلى \"المحذوفة مؤخرًا\"."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само снимки и видеоклипове с проверени съвпадащи сървърни копия могат да бъдат преместени в „Наскоро изтрити“."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু যাচাই করা সার্ভার কপির সঙ্গে মিলে যায় এমন ফটো ও ভিডিও “সম্প্রতি মুছে ফেলা” অ্যালবামে সরানো যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només les fotos i els vídeos amb còpies verificades del servidor coincidents es poden moure a Eliminats recentment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do seznamu Nedávno smazané lze přesunout pouze fotografie a videa s ověřenými shodnými kopiemi serveru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun billeder og videoer med bekræftede matchende serverkopier kan flyttes til Slettet for nylig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Fotos und Videos mit verifizierten übereinstimmenden Serverkopien können in „Zuletzt gelöscht“ verschoben werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο φωτογραφίες και βίντεο με επαληθευμένα αντίγραφα διακομιστή που ταιριάζουν μπορούν να μετακινηθούν στο Πρόσφατα διαγραμμένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo las fotos y videos con copias verificadas del servidor que coincidan se pueden mover a Eliminados recientemente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط عکس‌ها و ویدیوهایی که نسخهٔ مطابق و تأییدشده‌ای روی سرور دارند، می‌توانند به «اخیراً حذف‌شده» منتقل شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain valokuvat ja videot, joilla on vahvistettu vastaava palvelinkopio, voidaan siirtää Äskettäin poistettuihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les photos et vidéos dont les copies du serveur correspondantes ont été vérifiées peuvent être déplacées vers Récemment supprimées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן להעביר רק תמונות וסרטונים עם עותקי שרת תואמים מאומתים אל נמחקו לאחרונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल सत्यापित मिलान सर्वर प्रतियों वाले फ़ोटो और वीडियो को हाल ही में हटाए गए में ले जाया जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo fotografije i videozapisi s potvrđenim odgovarajućim kopijama poslužitelja mogu se premjestiti u Nedavno izbrisano."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak azok a fotók és videók helyezhetők át a Legutóbbi törlések mappába, amelyeknek ellenőrzött, egyező szerverpéldányai vannak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya foto dan video dengan salinan server pencocokan terverifikasi yang dapat dipindahkan ke Baru Dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo le foto e i video con copie del server corrispondenti verificate possono essere spostati in Eliminati di recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[最近削除した項目] に移動できるのは、一致するサーバーのコピーが確認された写真とビデオのみです。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тек расталған сәйкес сервер көшірмелері бар фотосуреттер мен бейнелерді Жақында жойылғандарға жылжытуға болады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치하는 것으로 확인된 서버 복사본이 있는 사진과 비디오만 최근 삭제된 항목으로 이동할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik nuotraukos ir vaizdo įrašai su patvirtintomis atitinkančiomis serverio kopijomis gali būti perkelti į Neseniai ištrintas."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
