    "Move %lld items to Trash?" : {
      "comment" : "A confirmation dialog title for moving multiple items to trash. The argument is the number of items.",
      "isCommentAutoGenerated" : true
    },
    "Move 1 item to Trash?" : {
      "comment" : "Confirmation dialog title for moving 1 item to Trash.",
      "isCommentAutoGenerated" : true
    },
    "Move backed-up photos and videos to Recently Deleted to free up space. Copies on your server remain safe." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل الصور ومقاطع الفيديو المنسوخة احتياطيًا إلى المحذوفة مؤخرًا لتوفير مساحة. تظل النسخ الموجودة على خادمك آمنة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преместете архивираните снимки и видеоклипове в „Наскоро изтрити“, за да освободите място. Копията на сървъра остават в безопасност."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "জায়গা খালি করতে ব্যাকআপ করা ছবি ও ভিডিও সম্প্রতি মুছে ফেলা-তে সরান। আপনার সার্ভারের কপিগুলো নিরাপদ থাকবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mou les fotos i els vídeos amb còpia de seguretat a Eliminats recentment per alliberar espai. Les còpies del servidor continuen segures."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvolněte místo přesunutím zálohovaných fotek a videí do Nedávno smazaných. Kopie na serveru zůstanou v bezpečí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt sikkerhedskopierede fotos og videoer til Slettet for nylig for at frigøre plads. Kopierne på din server forbliver sikre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebe gesicherte Fotos und Videos nach „Zuletzt gelöscht“, um Speicherplatz freizugeben. Die Kopien auf deinem Server bleiben sicher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετακινήστε τις αντιγραμμένες φωτογραφίες και τα βίντεο στα Πρόσφατα διαγραμμένα για να ελευθερώσετε χώρο. Τα αντίγραφα στον διακομιστή σας παραμένουν ασφαλή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve las fotos y los vídeos con copia de seguridad a Eliminado recientemente para liberar espacio. Las copias del servidor permanecerán seguras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای آزاد کردن فضا، عکس‌ها و ویدیوهای پشتیبان‌گیری‌شده را به «اخیراً حذف‌شده» منتقل کنید. نسخه‌های موجود در سرور امن می‌مانند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vapauta tilaa siirtämällä varmuuskopioidut kuvat ja videot Äskettäin poistettuihin. Palvelimella olevat kopiot säilyvät turvassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libérez de l’espace en déplaçant les photos et vidéos sauvegardées vers Supprimées récemment. Les copies sur votre serveur restent en sécurité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העבירו תמונות וסרטונים שגובו אל נמחקו לאחרונה כדי לפנות מקום. העותקים בשרת שלכם נשארים בטוחים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जगह खाली करने के लिए बैकअप की गई फ़ोटो और वीडियो को हाल ही में हटाए गए में ले जाएँ। सर्वर पर उनकी कॉपी सुरक्षित रहेगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premjestite sigurnosno kopirane fotografije i videozapise u Nedavno obrisano kako biste oslobodili prostor. Kopije na poslužitelju ostaju sigurne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hely felszabadításához helyezze át a biztonsági mentéssel rendelkező fotókat és videókat a Nemrég törölt albumba. A szerveren lévő példányok biztonságban maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindahkan foto dan video yang telah dicadangkan ke Baru Dihapus untuk mengosongkan ruang. Salinan di server Anda tetap aman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta le foto e i video con backup in Eliminati di recente per liberare spazio. Le copie sul server restano al sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空き容量を増やすため、バックアップ済みの写真とビデオを「最近削除した項目」に移動します。サーバー上のコピーは安全です。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Орын босату үшін сақтық көшірмесі бар фотосуреттер мен бейнелерді «Жуырда жойылғандар» бөліміне жылжытыңыз. Сервердегі көшірмелер қауіпсіз қалады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공간을 확보하려면 백업된 사진과 비디오를 '최근 삭제된 항목'으로 이동하세요. 서버의 복사본은 안전하게 유지됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkelkite atsargines kopijas turinčias nuotraukas ir vaizdo įrašus į „Neseniai ištrinti“, kad atlaisvintumėte vietos. Kopijos serveryje liks saugios."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alihkan foto dan video yang telah disandarkan ke Baru Dipadam untuk mengosongkan ruang. Salinan pada pelayan anda kekal selamat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt sikkerhetskopierte bilder og videoer til Nylig slettet for å frigjøre plass. Kopiene på serveren forblir trygge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaats geback-upte foto's en video's naar Recent verwijderd om ruimte vrij te maken. De kopieën op je server blijven veilig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenieś zdjęcia i filmy z kopią zapasową do „Ostatnio usunięte”, aby zwolnić miejsce. Kopie na serwerze pozostaną bezpieczne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova as fotos e os vídeos com cópia de segurança para Apagados recentemente para libertar espaço. As cópias no servidor permanecem seguras."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutați fotografiile și videoclipurile cu copie de siguranță în Șterse recent pentru a elibera spațiu. Copiile de pe server rămân în siguranță."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместите фотографии и видео с резервными копиями в «Недавно удаленные», чтобы освободить место. Копии на сервере останутся в безопасности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presuňte zálohované fotografie a videá do Nedávno vymazaných, aby ste uvoľnili miesto. Kópie na serveri zostanú v bezpečí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premaknite varnostno kopirane fotografije in videoposnetke v Nedavno izbrisano, da sprostite prostor. Kopije v strežniku ostanejo varne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytta säkerhetskopierade foton och videor till Senast raderade för att frigöra utrymme. Kopiorna på servern förblir säkra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้ายรูปภาพและวิดีโอที่สำรองข้อมูลแล้วไปยังที่เพิ่งลบล่าสุดเพื่อเพิ่มพื้นที่ว่าง สำเนาบนเซิร์ฟเวอร์จะยังคงปลอดภัย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yer açmak için yedeklenmiş fotoğraf ve videoları Son Silinenler'e taşıyın. Sunucunuzdaki kopyalar güvende kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемістіть фото та відео з резервними копіями до «Нещодавно видалені», щоб звільнити місце. Копії на сервері залишаться в безпеці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển ảnh và video đã sao lưu vào Đã xóa gần đây để giải phóng dung lượng. Bản sao trên máy chủ của bạn vẫn an toàn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将已备份的照片和视频移至“最近删除”以释放空间。服务器上的副本不会受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將已備份的相片和影片移至「最近刪除」以釋放空間。伺服器上的副本不會受到影響。"
          }
        }
      }
    },
