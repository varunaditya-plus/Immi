    "Links you create from an album or a photo will show up here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر هنا الروابط التي تنشئها من ألبوم أو صورة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Връзките, които създадете от албум или снимка, ще се показват тук."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যালবাম বা ছবি থেকে তৈরি করা লিঙ্কগুলো এখানে দেখা যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els enllaços que creïs des d'un àlbum o una foto apareixeran aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde se zobrazí odkazy, které vytvoříte z alba nebo fotky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links, du opretter fra et album eller foto, vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links, die du aus einem Album oder Foto erstellst, werden hier angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι σύνδεσμοι που δημιουργείτε από ένα άλμπουμ ή μια φωτογραφία θα εμφανίζονται εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces que crees desde un álbum o una foto aparecerán aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیوندهایی که از آلبوم یا عکس ایجاد می‌کنید اینجا نمایش داده می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumista tai kuvasta luomasi linkit näkyvät täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens créés à partir d’un album ou d’une photo apparaîtront ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קישורים שתיצרו מאלבום או מתמונה יופיעו כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एल्बम या फ़ोटो से बनाए गए लिंक यहाँ दिखाई देंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poveznice koje izradite iz albuma ili fotografije pojavit će se ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az albumokból vagy fotókból létrehozott hivatkozások itt jelennek meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautan yang Anda buat dari album atau foto akan muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I link creati da un album o da una foto verranno visualizzati qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルバムや写真から作成したリンクがここに表示されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Альбомнан немесе фотосуреттен жасалған сілтемелер осында көрсетіледі."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앨범이나 사진에서 생성한 링크가 여기에 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuorodos, kurias sukursite iš albumo ar nuotraukos, bus rodomos čia."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pautan yang anda cipta daripada album atau foto akan dipaparkan di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lenker du oppretter fra et album eller bilde, vises her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links die je vanuit een album of foto aanmaakt, verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linki utworzone z albumu lub zdjęcia pojawią się tutaj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As ligações que criar a partir de um álbum ou de uma foto aparecerão aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkurile create dintr-un album sau dintr-o fotografie vor apărea aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появятся ссылки, созданные из альбомов или фотографий."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkazy vytvorené z albumu alebo fotografie sa zobrazia tu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezave, ki jih ustvarite iz albuma ali fotografije, bodo prikazane tukaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Länkar som du skapar från ett album eller ett foto visas här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลิงก์ที่คุณสร้างจากอัลบั้มหรือรูปภาพจะแสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir albüm veya fotoğraftan oluşturduğunuz bağlantılar burada görünecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посилання, створені з альбому чи фото, з’являться тут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liên kết bạn tạo từ album hoặc ảnh sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从相册或照片创建的链接将显示在这里。"
