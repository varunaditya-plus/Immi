    "Exit Assistive Access and sign in to Immich first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اخرج من الوصول المساعد وسجّل الدخول إلى Immich أولًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Излезте от подпомагания достъп и първо влезте в Immich."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সহায়ক অ্যাক্সেস থেকে বের হয়ে প্রথমে Immich-এ সাইন ইন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surt de l'Accés assistit i inicia sessió a Immich primer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejprve ukončete Asistivní přístup a přihlaste se k Immich."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afslut først Forenklet adgang, og log ind på Immich."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende zuerst den Unterstützenden Zugriff und melde dich bei Immich an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βγείτε πρώτα από την Υποβοηθούμενη πρόσβαση και συνδεθείτε στο Immich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sal del Acceso asistido e inicia sesión en Immich primero."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابتدا از دسترسی کمکی خارج شوید و وارد Immich شوید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistu ensin Avustetusta käytöstä ja kirjaudu Immichiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez d’abord Accès d’aide et connectez-vous à Immich."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תחילה יש לצאת מגישה מסייעת ולהתחבר ל-Immich."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले सहायक एक्सेस से बाहर निकलें और Immich में साइन इन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izađite iz Pomoćnog pristupa i najprije se prijavite u Immich."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Először lépjen ki a Kisegítő hozzáférésből, majd jelentkezzen be az Immich szolgáltatásba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluar dari Akses Bantuan dan masuk ke Immich terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima esci da Accesso assistito e accedi a Immich."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先にアシスティブアクセスを終了し、Immichにサインインしてください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алдымен Көмекші қолжетімділіктен шығып, Immich жүйесіне кіріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 보조 접근을 종료하고 Immich에 로그인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pirmiausia išjunkite Pagalbinę prieigą ir prisijunkite prie Immich."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluar daripada Akses Bantuan dan log masuk ke Immich dahulu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutt Assistert tilgang og logg på Immich først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit eerst Ondersteunende toegang af en meld je aan bij Immich."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw wyjdź z Dostępu wspomaganego i zaloguj się do Immich."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saia do Acesso assistido e inicie primeiro sessão no Immich."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieșiți din Acces asistiv și autentificați-vă mai întâi în Immich."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала выйдите из режима «Упрощенный доступ» и войдите в Immich."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najskôr ukončite Asistovaný prístup a prihláste sa do služby Immich."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprej zapustite Pomožni dostop in se prijavite v Immich."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta Hjälpmedelsåtkomst och logga in på Immich först."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออกจากการช่วยเหลือการเข้าถึงและเข้าสู่ระบบ Immich ก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce Yardımcı Erişim'den çıkın ve Immich'te oturum açın."
