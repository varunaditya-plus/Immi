    "Photo library access is required to show albums." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلزم الوصول إلى مكتبة الصور لعرض الألبومات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За показване на албумите е необходим достъп до библиотеката със снимки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যালবাম দেখাতে ফটো লাইব্রেরিতে অ্যাক্সেস প্রয়োজন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cal accedir a la fototeca per mostrar els àlbums."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro zobrazení alb je vyžadován přístup ke knihovně fotek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kræves adgang til fotobiblioteket for at vise album."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Anzeigen von Alben ist Zugriff auf die Fotomediathek erforderlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαιτείται πρόσβαση στη βιβλιοθήκη φωτογραφιών για την εμφάνιση άλμπουμ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita acceso a la fototeca para mostrar los álbumes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای نمایش آلبوم‌ها، دسترسی به کتابخانه عکس لازم است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumien näyttäminen edellyttää kuvakirjaston käyttöoikeutta."
