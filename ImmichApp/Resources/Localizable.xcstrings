          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบรายการที่เก่ากว่าวันที่ที่เลือก ซึ่งอยู่นอกกฎการเก็บรักษาของคุณและมีสำเนาที่ตรงกันบนเซิร์ฟเวอร์ที่ตรวจสอบแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınırdan daha eski hiçbir öğe, saklama kurallarınız dışında eşleşen sunucu kopyalarıyla doğrulanmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жодні елементи, старші за обмеження, не мають підтверджених відповідних серверних копій поза вашими правилами зберігання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có mục nào cũ hơn thời hạn đã xác minh các bản sao máy chủ phù hợp nằm ngoài quy tắc lưu giữ của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有找到早于所选日期、不在保留规则范围内且具有已验证匹配服务器副本的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有找到早於所選日期、不在保留規則範圍內且具有已驗證相符伺服器副本的項目。"
          }
        }
      },
      "comment" : "The cutoff is the selected date. Keep rules preserve selected media on the device."
    },
