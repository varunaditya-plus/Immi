    "Do you want to delete these photos or remove them from this collection?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد حذف هذه الصور أم إزالتها من هذه المجموعة؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искате ли да изтриете тези снимки или да ги премахнете от тази колекция?"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি কি এই ছবিগুলো মুছতে চান, নাকি এই সংগ্রহ থেকে সরাতে চান?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols eliminar aquestes fotos o treure-les d'aquesta col·lecció?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete tyto fotky smazat, nebo je pouze odebrat z této sbírky?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du slette disse fotos eller fjerne dem fra denne samling?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du diese Fotos löschen oder aus dieser Sammlung entfernen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θέλετε να διαγράψετε αυτές τις φωτογραφίες ή να τις αφαιρέσετε από αυτή τη συλλογή;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres eliminar estas fotos o quitarlas de esta colección?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "می‌خواهید این عکس‌ها را حذف کنید یا از این مجموعه بردارید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko poistaa nämä kuvat vai poistaa ne vain tästä kokoelmasta?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous supprimer ces photos ou les retirer de cette collection ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למחוק את התמונות האלה או להסיר אותן מהאוסף הזה?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप इन फ़ोटो को हटाना चाहते हैं या इस संग्रह से निकालना चाहते हैं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Želite li izbrisati ove fotografije ili ih ukloniti iz ove zbirke?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törölni szeretné ezeket a fotókat, vagy csak eltávolítani ebből a gyűjteményből?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah Anda ingin menghapus foto-foto ini atau mengeluarkannya dari koleksi ini?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi eliminare queste foto o rimuoverle da questa raccolta?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの写真を削除しますか、それともこのコレクションから取り除きますか？"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осы фотосуреттерді жойғыңыз келе ме, әлде бұл жинақтан алып тастағыңыз келе ме?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사진을 삭제하거나 이 모음에서 제거하시겠습니까?"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar norite ištrinti šias nuotraukas, ar pašalinti jas iš šio rinkinio?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adakah anda mahu memadam foto ini atau mengeluarkannya daripada koleksi ini?"
          }
        },
        "nb" : {
