    "Allow Photos access before syncing local assets." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Photos access before syncing local assets."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الصور قبل مزامنة عناصر الوسائط على الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете достъп до снимки, преди да синхронизирате локалните мултимедийни файлове."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিভাইসের মিডিয়া আইটেম সিঙ্ক করার আগে ফটো অ্যাক্সেসের অনুমতি দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet l'accés a Fotos abans de sincronitzar els fitxers multimèdia locals."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před synchronizací místních mediálních souborů povolte přístup k Fotkám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad adgang til billeder, før du synkroniserer lokale mediefiler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie den Zugriff auf Fotos, bevor Sie lokale Medien synchronisieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε την πρόσβαση στις Φωτογραφίες πριν συγχρονίσετε τα τοπικά αρχεία πολυμέσων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita el acceso a Fotos antes de sincronizar los archivos multimedia locales."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش از همگام‌سازی موارد رسانه‌ای دستگاه، دسترسی به عکس‌ها را مجاز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli kuvien käyttö ennen paikallisten mediatiedostojen synkronointia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès à Photos avant de synchroniser les éléments locaux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאפשר גישה לתמונות לפני סנכרון פריטי המדיה במכשיר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस के मीडिया आइटम सिंक करने से पहले फ़ोटो तक पहुँच की अनुमति दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopustite pristup fotografijama prije sinkronizacije lokalnih medijskih datoteka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyi médiafájlok szinkronizálása előtt engedélyezze a Photos hozzáférést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
