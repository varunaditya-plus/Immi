    "No accessible photos or videos were found in the selected albums. Allow full Photos access to check the rest." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No accessible photos or videos were found in the selected albums. Allow full Photos access to check the rest."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم العثور على صور أو مقاطع فيديو يمكن الوصول إليها في الألبومات المحددة. اسمح بالوصول الكامل للصور للتحقق من الباقي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В избраните албуми не бяха намерени достъпни снимки или видеоклипове. Разрешете пълен достъп до снимки, за да проверите останалото."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নির্বাচিত অ্যালবামে কোনো অ্যাক্সেসযোগ্য ছবি বা ভিডিও পাওয়া যায়নি। বাকিগুলি পরীক্ষা করার জন্য সম্পূর্ণ ফটো অ্যাক্সেসের অনুমতি দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'han trobat fotos ni vídeos accessibles als àlbums seleccionats. Permet l'accés complet a Fotos per comprovar la resta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve vybraných albech nebyly nalezeny žádné dostupné fotografie ani videa. Chcete-li zkontrolovat zbytek, povolte úplný přístup k Fotkám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blev ikke fundet nogen tilgængelige billeder eller videoer i de valgte album. Tillad fuld adgang til billeder for at kontrollere resten."
