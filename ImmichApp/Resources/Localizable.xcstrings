    "Review synchronization data or remove backed-up device copies to reclaim storage." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع بيانات المزامنة أو أزل نُسخ الجهاز المنسوخة احتياطيًا لاستعادة مساحة التخزين."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прегледайте данните за синхронизация или премахнете архивираните копия от устройството, за да освободите място."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্টোরেজ খালি করতে সিঙ্ক্রোনাইজেশন ডেটা পর্যালোচনা করুন অথবা ডিভাইসে থাকা ব্যাকআপ কপিগুলো সরান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa les dades de sincronització o elimina les còpies del dispositiu que ja tenen còpia de seguretat per recuperar espai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte synchronizační data nebo uvolněte úložiště odebráním zálohovaných kopií ze zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgå synkroniseringsdata, eller fjern sikkerhedskopierede kopier fra enheden for at frigøre lagerplads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die Synchronisierungsdaten oder entferne gesicherte Gerätekopien, um Speicherplatz freizugeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε τα δεδομένα συγχρονισμού ή αφαιρέστε τα αντίγραφα της συσκευής που έχουν δημιουργηθεί για να ανακτήσετε αποθηκευτικό χώρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa los datos de sincronización o elimina las copias del dispositivo que ya tengan copia de seguridad para recuperar espacio de almacenamiento."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای آزاد کردن فضای ذخیره‌سازی، داده‌های همگام‌سازی را مرور کنید یا نسخه‌های پشتیبان‌گیری‌شده دستگاه را بردارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista synkronointitiedot tai vapauta tallennustilaa poistamalla varmuuskopioidut kopiot laitteelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez les données de synchronisation ou supprimez les copies sauvegardées de l’appareil pour récupérer de l’espace de stockage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עיינו בנתוני הסנכרון או הסירו עותקים שגובו מהמכשיר כדי לפנות שטח אחסון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक डेटा की समीक्षा करें या स्टोरेज खाली करने के लिए डिवाइस से बैकअप की गई कॉपी निकालें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregledajte podatke sinkronizacije ili uklonite sigurnosno kopirane kopije s uređaja kako biste oslobodili prostor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekintse át a szinkronizálási adatokat, vagy távolítsa el az eszközön lévő, biztonsági mentéssel rendelkező példányokat tárhely felszabadításához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinjau data sinkronisasi atau hapus salinan perangkat yang telah dicadangkan untuk memperoleh kembali ruang penyimpanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla i dati di sincronizzazione o rimuovi le copie sul dispositivo di cui è stato eseguito il backup per recuperare spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期データを確認するか、バックアップ済みのデバイス上のコピーを削除して空き容量を増やします。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жад орнын босату үшін синхрондау деректерін қарап шығыңыз немесе сақтық көшірмесі бар құрылғы көшірмелерін жойыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화 데이터를 검토하거나 백업된 기기 복사본을 제거하여 저장 공간을 확보하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peržiūrėkite sinchronizavimo duomenis arba pašalinkite atsargines kopijas turinčias įrenginio kopijas, kad atlaisvintumėte vietos."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semak data penyegerakan atau keluarkan salinan peranti yang telah disandarkan untuk mendapatkan semula ruang storan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se gjennom synkroniseringsdata eller fjern sikkerhetskopierte enhetskopier for å frigjøre lagringsplass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk synchronisatiegegevens of verwijder geback-upte kopieën van het apparaat om opslagruimte vrij te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejrzyj dane synchronizacji lub usuń kopie na urządzeniu, które mają kopię zapasową, aby odzyskać miejsce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveja os dados de sincronização ou remova as cópias do dispositivo que já têm cópia de segurança para recuperar espaço."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Examinați datele de sincronizare sau eliminați copiile de pe dispozitiv care au copii de siguranță pentru a recupera spațiul de stocare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просмотрите данные синхронизации или удалите с устройства копии, сохраненные в резервной копии, чтобы освободить место."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skontrolujte údaje synchronizácie alebo odstráňte zo zariadenia zálohované kópie, aby ste získali úložný priestor."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preglejte podatke sinhronizacije ali odstranite varnostno kopirane kopije iz naprave, da pridobite prostor za shranjevanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granska synkroniseringsdata eller ta bort säkerhetskopierade enhetskopior för att återfå lagringsutrymme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบข้อมูลการซิงก์หรือนำสำเนาบนอุปกรณ์ที่สำรองข้อมูลแล้วออกเพื่อคืนพื้นที่จัดเก็บข้อมูล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depolama alanını geri kazanmak için eşitleme verilerini inceleyin veya yedeklenmiş cihaz kopyalarını kaldırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перегляньте дані синхронізації або вилучіть із пристрою копії, для яких створено резервні копії, щоб звільнити місце."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem lại dữ liệu đồng bộ hoặc gỡ các bản sao trên thiết bị đã được sao lưu để lấy lại dung lượng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查同步数据，或移除设备上已有备份的副本以回收存储空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查同步資料，或移除裝置上已有備份的副本以回收儲存空間。"
          }
        }
      }
    },
