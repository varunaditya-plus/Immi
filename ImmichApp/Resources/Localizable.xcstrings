    "Select a cutoff date, then continue to find backed-up items." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد تاريخًا فاصلًا، ثم تابع للعثور على العناصر المنسوخة احتياطيًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете крайна дата, след което продължете, за да намерите архивираните елементи."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি সীমার তারিখ নির্বাচন করুন, তারপর ব্যাকআপ করা আইটেম খুঁজতে এগিয়ে যান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona una data límit i continua per trobar els elements amb còpia de seguretat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte rozhodné datum a poté pokračujte k vyhledání zálohovaných položek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en skæringsdato, og fortsæt derefter for at finde sikkerhedskopierede emner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Stichtag aus und fahre dann fort, um gesicherte Elemente zu finden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε μια ημερομηνία αποκοπής και συνεχίστε για να βρείτε τα στοιχεία που έχουν αντιγραφεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona una fecha límite y continúa para buscar elementos con copia de seguridad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک تاریخ مرزی انتخاب کنید، سپس برای یافتن موارد پشتیبان‌گیری‌شده ادامه دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse rajapäivä ja jatka sitten varmuuskopioitujen kohteiden etsimiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez une date limite, puis continuez pour rechercher les éléments sauvegardés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחרו תאריך סף ולאחר מכן המשיכו כדי למצוא פריטים שגובו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अंतिम तिथि चुनें, फिर बैकअप किए गए आइटम खोजने के लिए आगे बढ़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite granični datum, a zatim nastavite kako biste pronašli sigurnosno kopirane stavke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon egy határdátumot, majd folytassa a biztonsági mentéssel rendelkező elemek keresését."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
