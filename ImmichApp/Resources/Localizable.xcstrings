    "Open Back Up Photos to select your albums and turn on automatic backup." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح نسخ الصور احتياطيًا لتحديد ألبوماتك وتشغيل النسخ الاحتياطي التلقائي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отворете „Архивиране на снимки“, за да изберете албумите си и да включите автоматичното архивиране."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অ্যালবাম বেছে নিতে এবং স্বয়ংক্রিয় ব্যাকআপ চালু করতে ছবি ব্যাকআপ খুলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre Fes una còpia de seguretat de les fotos per seleccionar els àlbums i activar la còpia automàtica."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete Zálohovat fotky, vyberte alba a zapněte automatické zálohování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Sikkerhedskopiér fotos for at vælge dine album og slå automatisk sikkerhedskopiering til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne „Fotos sichern“, um deine Alben auszuwählen und die automatische Sicherung zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε τα Αντίγραφα ασφαλείας φωτογραφιών για να επιλέξετε άλμπουμ και να ενεργοποιήσετε την αυτόματη δημιουργία αντιγράφων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Crear copia de seguridad de las fotos para seleccionar tus álbumes y activar la copia de seguridad automática."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای انتخاب آلبوم‌ها و روشن کردن پشتیبان‌گیری خودکار، «پشتیبان‌گیری از عکس‌ها» را باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa Varmuuskopioi kuvat, valitse albumit ja ota automaattinen varmuuskopiointi käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Sauvegarder les photos pour sélectionner vos albums et activer la sauvegarde automatique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתחו את גיבוי התמונות כדי לבחור אלבומים ולהפעיל גיבוי אוטומטי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने एल्बम चुनने और स्वचालित बैकअप चालू करने के लिए फ़ोटो का बैकअप लें खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite Sigurnosno kopiranje fotografija kako biste odabrali albume i uključili automatsko sigurnosno kopiranje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyissa meg a Fotók biztonsági mentése képernyőt az albumok kiválasztásához és az automatikus biztonsági mentés bekapcsolásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
