        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoriler, seçili albümler ve seçili medya türü bu cihazdan kaldırılmayacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улюблені, вибрані альбоми та вибраний тип медіа не буде видалено із цього пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục ưa thích, album đã chọn và loại phương tiện đã chọn sẽ không bị xóa khỏi thiết bị này."
