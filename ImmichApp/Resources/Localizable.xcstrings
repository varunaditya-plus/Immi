        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φωτογραφίες από αυτή την ημέρα προηγούμενων ετών θα εμφανίζονται εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
