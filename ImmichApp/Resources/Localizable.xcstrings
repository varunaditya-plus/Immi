        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atidarykite „Kurti nuotraukų atsargines kopijas“, pasirinkite albumus ir įjunkite automatinį atsarginių kopijų kūrimą."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
