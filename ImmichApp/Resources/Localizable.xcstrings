    "Automatic backup is off. Manual uploads and transfers already in progress can still finish." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic backup is off. Manual uploads and transfers already in progress can still finish."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النسخ الاحتياطي التلقائي معطل. لا يزال من الممكن أن تنتهي عمليات التحميل والنقل اليدوية الجارية بالفعل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматичното архивиране е изключено. Ръчните качвания и прехвърляния, които вече са в ход, все още могат да завършат."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বয়ংক্রিয় ব্যাকআপ বন্ধ আছে। ইতিমধ্যেই চলছে ম্যানুয়াল আপলোড এবং স্থানান্তরগুলি এখনও শেষ হতে পারে৷"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La còpia de seguretat automàtica està desactivada. Les càrregues manuals i les transferències que ja estan en curs encara poden finalitzar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatické zálohování je vypnuté. Ruční nahrávání a přenosy, které již probíhají, lze stále dokončit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk backup er slået fra. Manuelle uploads og overførsler, der allerede er i gang, kan stadig afsluttes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Sicherung ist deaktiviert. Bereits laufende manuelle Uploads und Übertragungen können weiterhin abgeschlossen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αυτόματη δημιουργία αντιγράφων ασφαλείας είναι απενεργοποιημένη. Οι μη αυτόματες μεταφορτώσεις και μεταφορές που βρίσκονται ήδη σε εξέλιξη μπορούν ακόμα να ολοκληρωθούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de seguridad automática está desactivada. Las cargas y transferencias manuales que ya están en curso aún pueden finalizar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پشتیبان گیری خودکار خاموش است. آپلودها و انتقال‌های دستی که از قبل در حال انجام هستند هنوز می‌توانند به پایان برسند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaattinen varmuuskopiointi on pois päältä. Jo käynnissä olevat manuaaliset lataukset ja siirrot voivat silti päättyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde automatique est désactivée. Les envois manuels et les transferts déjà en cours peuvent encore se terminer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגיבוי האוטומטי כבוי. העלאות והעברות ידניות שכבר מתבצעות עדיין יכולות להסתיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वचालित बैकअप बंद है. पहले से चल रहे मैन्युअल अपलोड और स्थानांतरण अभी भी समाप्त हो सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatsko sigurnosno kopiranje je isključeno. Ručni prijenosi i prijenosi koji su već u tijeku još uvijek mogu završiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az automatikus biztonsági mentés ki van kapcsolva. A már folyamatban lévő kézi feltöltések és átvitelek még befejeződhetnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencadangan otomatis tidak aktif. Pengunggahan dan transfer manual yang sudah berlangsung masih dapat diselesaikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il backup automatico è disattivato. I caricamenti manuali e i trasferimenti già in corso possono ancora terminare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動バックアップはオフになっています。すでに進行中の手動アップロードと転送は完了する可能性があります。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматты сақтық көшірме өшірулі. Орындалып жатқан қолмен жүктеп салулар мен тасымалдаулар әлі де аяқталуы мүмкін."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 백업이 꺼져 있습니다. 이미 진행 중인 수동 업로드 및 전송은 계속 완료될 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatinis atsarginis kopijavimas išjungtas. Jau vykdomi rankiniai įkėlimai ir perkėlimai gali būti baigti."
