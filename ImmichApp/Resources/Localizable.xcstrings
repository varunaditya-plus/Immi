    "Favorites, selected albums, and the selected media type will not be removed from this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تُزال المفضلة والألبومات المحددة ونوع الوسائط المحدد من هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любимите, избраните албуми и избраният тип медия няма да бъдат премахнати от това устройство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পছন্দেরগুলো, নির্বাচিত অ্যালবাম এবং নির্বাচিত মিডিয়ার ধরন এই ডিভাইস থেকে সরানো হবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els Favorits, els àlbums seleccionats i el tipus de contingut seleccionat no s'eliminaran d'aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblíbené, vybraná alba a zvolený typ médií nebudou z tohoto zařízení odebrány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoritter, valgte album og den valgte medietype fjernes ikke fra denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoriten, ausgewählte Alben und der ausgewählte Medientyp werden nicht von diesem Gerät entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα Αγαπημένα, τα επιλεγμένα άλμπουμ και ο επιλεγμένος τύπος πολυμέσων δεν θα αφαιρεθούν από αυτή τη συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoritos, los álbumes seleccionados y el tipo de archivo seleccionado no se eliminarán de este dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "علاقه‌مندی‌ها، آلبوم‌های انتخاب‌شده و نوع رسانه انتخاب‌شده از این دستگاه حذف نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suosikkeja, valittuja albumeita ja valittua mediatyyppiä ei poisteta tästä laitteesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les favoris, les albums sélectionnés et le type de média choisi ne seront pas supprimés de cet appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המועדפים, האלבומים שנבחרו וסוג המדיה שנבחר לא יוסרו מהמכשיר הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पसंदीदा, चुने गए एल्बम और चुना गया मीडिया प्रकार इस डिवाइस से नहीं हटाए जाएँगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoriti, odabrani albumi i odabrana vrsta medija neće se ukloniti s ovog uređaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Kedvencek, a kiválasztott albumok és a kiválasztott médiatípus nem lesz eltávolítva erről az eszközről."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorit, album terpilih, dan jenis media terpilih tidak akan dihapus dari perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Preferiti, gli album selezionati e il tipo di contenuto selezionato non verranno rimossi da questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入り、選択したアルバム、選択したメディアタイプはこのデバイスから削除されません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таңдаулылар, таңдалған альбомдар және таңдалған медиа түрі бұл құрылғыдан жойылмайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾기, 선택한 앨범 및 선택한 미디어 유형은 이 기기에서 제거되지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mėgstamiausi, pasirinkti albumai ir pasirinktas medijos tipas nebus pašalinti iš šio įrenginio."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kegemaran, album yang dipilih dan jenis media yang dipilih tidak akan dikeluarkan daripada peranti ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoritter, valgte album og den valgte medietypen fjernes ikke fra denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorieten, geselecteerde albums en het geselecteerde mediatype worden niet van dit apparaat verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulubione, wybrane albumy i wybrany typ multimediów nie zostaną usunięte z tego urządzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Favoritos, os álbuns selecionados e o tipo de multimédia selecionado não serão removidos deste dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoritele, albumele selectate și tipul multimedia selectat nu vor fi eliminate de pe acest dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избранные, выбранные альбомы и выбранный тип медиафайлов не будут удалены с этого устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obľúbené, vybrané albumy a vybraný typ médií sa z tohto zariadenia neodstránia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priljubljeno, izbrani albumi in izbrana vrsta predstavnosti ne bodo odstranjeni iz te naprave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoriter, valda album och den valda mediatypen tas inte bort från den här enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการโปรด อัลบั้มที่เลือก และประเภทสื่อที่เลือกจะไม่ถูกนำออกจากอุปกรณ์นี้"
