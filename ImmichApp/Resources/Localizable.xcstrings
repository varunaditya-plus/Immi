    "Sign in again to resume the background upload queue." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in again to resume the background upload queue."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتسجيل الدخول مرة أخرى لاستئناف قائمة انتظار التحميل في الخلفية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влезте отново, за да възобновите опашката за качване във фонов режим."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যাকগ্রাউন্ড আপলোড সারি আবার শুরু করতে আবার সাইন ইন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna a iniciar la sessió per reprendre la cua de càrrega en segon pla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li obnovit frontu nahrávání na pozadí, znovu se přihlaste."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind igen for at genoptage køen for upload i baggrunden."
          }
