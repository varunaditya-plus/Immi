    "Photos from this day in previous years will show up here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر هنا صور هذا اليوم من السنوات السابقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимките от този ден през предишни години ще се показват тук."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগের বছরগুলোর এই দিনের ছবিগুলো এখানে দেখা যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fotos d'aquest dia d'anys anteriors apareixeran aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde se zobrazí fotky pořízené v tento den v předchozích letech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos fra denne dag i tidligere år vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos von diesem Tag in früheren Jahren werden hier angezeigt."
