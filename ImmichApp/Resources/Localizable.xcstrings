    "Background App Refresh is disabled. Enable it in Settings > General > Background App Refresh." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background App Refresh is disabled. Enable it in Settings > General > Background App Refresh."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تعطيل تحديث التطبيقات في الخلفية. قم بتمكينه في الإعدادات > عام > تحديث التطبيقات في الخلفية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опресняването на фоновото приложение е деактивирано. Активирайте го в Settings > General > Background App Refresh."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যাকগ্রাউন্ড অ্যাপ রিফ্রেশ অক্ষম করা হয়েছে। সেটিংস > সাধারণ > ব্যাকগ্রাউন্ড অ্যাপ রিফ্রেশে এটি সক্ষম করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'actualització de l'aplicació en segon pla està desactivada. Activeu-lo a Configuració > General > Actualització de l'aplicació en segon pla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizace aplikací na pozadí je zakázána. Povolte ji v Nastavení > Obecné > Obnovení aplikací na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
