    "Some shared uploads need attention. View Details to retry or remove them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some shared uploads need attention. View Details to retry or remove them."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج بعض التحميلات المشتركة إلى الاهتمام. عرض التفاصيل لإعادة المحاولة أو إزالتها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Някои споделени качвания изискват внимание. Вижте подробности, за да опитате отново или да ги премахнете."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিছু শেয়ার করা আপলোড মনোযোগ প্রয়োজন. পুনরায় চেষ্টা করতে বা অপসারণ করতে বিশদ দেখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunes càrregues compartides necessiten atenció. Mostra els detalls per tornar-los a provar o eliminar-los."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některá sdílená nahrávání vyžadují pozornost. Zobrazit podrobnosti a zkusit to znovu nebo je odebrat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle delte uploads kræver opmærksomhed. Se detaljer for at prøve igen eller fjerne dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige freigegebene Uploads erfordern Aufmerksamkeit. Details anzeigen, um es erneut zu versuchen oder zu entfernen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορισμένες κοινές μεταφορτώσεις χρειάζονται προσοχή. Δείτε Λεπτομέρειες για να τις δοκιμάσετε ξανά ή να τις αφαιρέσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas cargas compartidas necesitan atención. Ver detalles para volver a intentarlo o eliminarlos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برخی از آپلودهای مشترک نیاز به توجه دارند. مشاهده جزئیات برای امتحان مجدد یا حذف آنها."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotkut jaetut lataukset vaativat huomiota. Näytä tiedot, jos haluat yrittää uudelleen tai poistaa ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains envois partagés nécessitent votre attention. Consultez les détails pour réessayer ou les supprimer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה העלאות משותפות דורשות תשומת לב. הצג פרטים כדי לנסות שוב או להסיר אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ साझा अपलोड पर ध्यान देने की आवश्यकता है। पुनः प्रयास करने या उन्हें हटाने के लिए विवरण देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nekim dijeljenim prijenosima treba obratiti pozornost. Pogledajte pojedinosti da biste pokušali ponovno ili ih uklonili."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Néhány megosztott feltöltés figyelmet igényel. Nézze meg a részleteket az újrapróbálkozáshoz vagy eltávolításhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa unggahan yang dibagikan perlu mendapat perhatian. Lihat Detail untuk mencoba lagi atau menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni caricamenti condivisi richiedono attenzione. Visualizza i dettagli per riprovare o rimuoverli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の共有アップロードには注意が必要です。詳細を表示して再試行するか、削除してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кейбір ортақ жүктеп салуларға назар аудару қажет. Қайталап көру немесе жою үшін мәліметтерді қараңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 공유 업로드에는 주의가 필요합니다. 세부정보를 확인하여 다시 시도하거나 삭제하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reikia atkreipti dėmesį į kai kuriuos bendrinamus įkėlimus. Peržiūrėkite išsamią informaciją ir bandykite dar kartą arba pašalinkite."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa muat naik yang dikongsi memerlukan perhatian. Lihat Butiran untuk mencuba semula atau mengalih keluarnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen delte opplastinger trenger oppmerksomhet. Vis detaljer for å prøve på nytt eller fjerne dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
