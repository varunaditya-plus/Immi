    "NSLocalNetworkUsageDescription" : {
      "comment" : "Reason shown by iOS when connecting to an Immich server on the local network.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل SelfPhotos بخادم Immich عبر الشبكة المحلية لعرض الصور والفيديوهات ورفعها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos се свързва с вашия Immich сървър в локалната мрежа, за да преглеждате и качвате снимки и видеоклипове."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos ছবি ও ভিডিও দেখতে এবং আপলোড করতে স্থানীয় নেটওয়ার্কে আপনার Immich সার্ভারের সঙ্গে সংযোগ করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos es connecta al vostre servidor Immich a la xarxa local per veure i pujar fotos i vídeos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos se připojuje k vašemu serveru Immich v místní síti, abyste mohli prohlížet a nahrávat fotografie a videa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos opretter forbindelse til din Immich-server på det lokale netværk for at vise og overføre billeder og videoer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos verbindet sich über das lokale Netzwerk mit deinem Immich-Server, um Fotos und Videos anzuzeigen und hochzuladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το SelfPhotos συνδέεται στον διακομιστή Immich στο τοπικό δίκτυο για προβολή και μεταφόρτωση φωτογραφιών και βίντεο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos connects to your Immich server on the local network to view and upload photos and videos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos se conecta a tu servidor Immich en la red local para ver y subir fotos y vídeos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos برای نمایش و بارگذاری عکس‌ها و ویدیوها، از طریق شبکهٔ محلی به سرور Immich شما متصل می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos muodostaa yhteyden Immich-palvelimeesi lähiverkossa kuvien ja videoiden katselua ja lähettämistä varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos se connecte à votre serveur Immich sur le réseau local pour afficher et téléverser des photos et des vidéos."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos מתחבר לשרת Immich שלכם ברשת המקומית כדי להציג ולהעלות תמונות וסרטונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos फ़ोटो और वीडियो देखने और अपलोड करने के लिए स्थानीय नेटवर्क पर आपके Immich सर्वर से जुड़ता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos se povezuje s vašim Immich poslužiteljem na lokalnoj mreži radi pregledavanja i prijenosa fotografija i videozapisa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A SelfPhotos a helyi hálózaton csatlakozik az Immich-kiszolgálójához a fotók és videók megtekintéséhez és feltöltéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos terhubung ke server Immich Anda di jaringan lokal untuk melihat dan mengunggah foto serta video."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos si connette al tuo server Immich sulla rete locale per visualizzare e caricare foto e video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotosはローカルネットワーク上のImmichサーバーに接続し、写真やビデオの表示とアップロードを行います。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos фотосуреттер мен бейнелерді көру және жүктеп салу үшін жергілікті желідегі Immich серверіңізге қосылады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos는 로컬 네트워크의 Immich 서버에 연결하여 사진과 비디오를 보고 업로드합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos prisijungia prie jūsų Immich serverio vietiniame tinkle, kad galėtumėte peržiūrėti ir įkelti nuotraukas bei vaizdo įrašus."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos bersambung ke pelayan Immich anda pada rangkaian setempat untuk melihat dan memuat naik foto serta video."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos kobler til Immich-serveren din på lokalnettverket for å vise og laste opp bilder og videoer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos maakt via het lokale netwerk verbinding met je Immich-server om foto's en video's te bekijken en te uploaden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos łączy się z Twoim serwerem Immich w sieci lokalnej, aby wyświetlać i przesyłać zdjęcia oraz filmy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SelfPhotos liga-se ao seu servidor Immich na rede local para ver e carregar fotografias e vídeos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos se conectează la serverul dvs. Immich din rețeaua locală pentru a vizualiza și încărca fotografii și videoclipuri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos подключается к вашему серверу Immich в локальной сети для просмотра и загрузки фотографий и видео."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos sa pripája k vášmu serveru Immich v miestnej sieti, aby ste mohli prezerať a nahrávať fotografie a videá."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos se poveže z vašim strežnikom Immich v lokalnem omrežju za ogled in nalaganje fotografij in videoposnetkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos ansluter till din Immich-server på det lokala nätverket för att visa och ladda upp bilder och videor."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos เชื่อมต่อกับเซิร์ฟเวอร์ Immich ของคุณบนเครือข่ายภายในเพื่อดูและอัปโหลดรูปภาพและวิดีโอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos, fotoğraf ve videoları görüntülemek ve yüklemek için yerel ağdaki Immich sunucunuza bağlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos підключається до вашого сервера Immich у локальній мережі для перегляду та завантаження фотографій і відео."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos kết nối với máy chủ Immich của bạn trên mạng cục bộ để xem và tải ảnh cũng như video lên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos 连接到本地网络中的 Immich 服务器，以查看和上传照片及视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos 連線至區域網路中的 Immich 伺服器，以檢視和上傳照片及影片。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Reason shown by iOS when requesting access to the photo library.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض SelfPhotos الصور الموجودة على هذا الجهاز إلى جانب الصور الموجودة على خادم Immich، لتتمكن من معرفة الصور التي لم تُنسخ احتياطيًا بعد ورفعها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos показва снимките на това устройство заедно със снимките на вашия Immich сървър, за да виждате кои още не са архивирани и да ги качите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos এই ডিভাইসের ছবিগুলোর পাশে আপনার Immich সার্ভারের ছবিগুলো দেখায়, যাতে কোনগুলো এখনো ব্যাকআপ হয়নি তা দেখে আপলোড করতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos mostra les fotos d'aquest dispositiu al costat de les del servidor Immich perquè pugueu veure quines encara no tenen còpia de seguretat i pujar-les."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos zobrazuje fotografie v tomto zařízení společně s fotografiemi na serveru Immich, abyste viděli, které ještě nejsou zálohované, a mohli je nahrát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos viser billederne på denne enhed sammen med dem på din Immich-server, så du kan se, hvilke der endnu ikke er sikkerhedskopieret, og overføre dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos zeigt die Fotos auf diesem Gerät zusammen mit denen auf deinem Immich-Server, damit du noch nicht gesicherte Fotos erkennen und hochladen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το SelfPhotos εμφανίζει τις φωτογραφίες αυτής της συσκευής μαζί με εκείνες στον διακομιστή Immich, ώστε να βλέπετε ποιες δεν έχουν δημιουργηθεί ακόμη αντίγραφα ασφαλείας και να τις ανεβάζετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos shows the photos on this device alongside the ones on your Immich server, so you can see what is not backed up yet and upload it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos muestra las fotos de este dispositivo junto con las de tu servidor Immich para que puedas ver cuáles aún no tienen copia de seguridad y subirlas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos عکس‌های این دستگاه را در کنار عکس‌های سرور Immich شما نشان می‌دهد تا ببینید کدام‌ها هنوز پشتیبان‌گیری نشده‌اند و آن‌ها را بارگذاری کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos näyttää tämän laitteen kuvat Immich-palvelimesi kuvien rinnalla, jotta näet, mitä ei ole vielä varmuuskopioitu, ja voit lähettää ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos affiche les photos de cet appareil avec celles de votre serveur Immich afin d'identifier celles qui ne sont pas encore sauvegardées et de les téléverser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos מציג את התמונות במכשיר לצד התמונות בשרת Immich, כדי שתוכלו לראות אילו תמונות עדיין לא גובו ולהעלות אותן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos इस डिवाइस की फ़ोटो को आपके Immich सर्वर की फ़ोटो के साथ दिखाता है, ताकि आप देख सकें कि किनका अभी बैकअप नहीं हुआ है और उन्हें अपलोड कर सकें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos prikazuje fotografije na ovom uređaju uz one na vašem Immich poslužitelju kako biste vidjeli koje još nisu sigurnosno kopirane i prenijeli ih."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A SelfPhotos az eszközön lévő fotókat az Immich-kiszolgálón találhatókkal együtt mutatja, így láthatja, melyek nincsenek még mentve, és feltöltheti őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos menampilkan foto di perangkat ini bersama foto di server Immich Anda, sehingga Anda dapat melihat foto yang belum dicadangkan dan mengunggahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos mostra le foto su questo dispositivo insieme a quelle sul server Immich, così puoi vedere quali non sono ancora state salvate e caricarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotosは、このデバイス上の写真とImmichサーバー上の写真を並べて表示し、まだバックアップされていない写真を確認してアップロードできるようにします。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos осы құрылғыдағы фотоларды Immich серверіндегі фотолармен бірге көрсетеді, осылайша әлі сақтық көшірмесі жасалмағандарын көріп, жүктеп сала аласыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos는 이 기기의 사진과 Immich 서버의 사진을 함께 표시하여 아직 백업되지 않은 사진을 확인하고 업로드할 수 있게 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos rodo šio įrenginio nuotraukas kartu su nuotraukomis jūsų Immich serveryje, kad matytumėte, kurios dar neįtrauktos į atsarginę kopiją, ir galėtumėte jas įkelti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos memaparkan foto pada peranti ini bersama foto pada pelayan Immich anda supaya anda boleh melihat foto yang belum disandarkan dan memuat naiknya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos viser bildene på denne enheten sammen med dem på Immich-serveren din, slik at du kan se hvilke som ikke er sikkerhetskopiert ennå, og laste dem opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos toont de foto's op dit apparaat naast die op je Immich-server, zodat je kunt zien welke nog niet zijn geback-upt en ze kunt uploaden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos pokazuje zdjęcia na tym urządzeniu obok zdjęć na serwerze Immich, dzięki czemu możesz sprawdzić, które nie zostały jeszcze zapisane w kopii zapasowej, i je przesłać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SelfPhotos mostra as fotografias deste dispositivo juntamente com as do servidor Immich, para que possa ver quais ainda não têm cópia de segurança e carregá-las."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos afișează pozele de pe acest dispozitiv împreună cu cele de pe serverul Immich, ca să vedeți ce nu are încă o copie de siguranță și să le încărcați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos показывает фотографии на этом устройстве вместе с фотографиями на сервере Immich, чтобы вы могли увидеть, какие ещё не сохранены в резервной копии, и загрузить их."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos zobrazuje fotky v tomto zariadení spolu s fotkami na serveri Immich, aby ste videli, ktoré ešte nie sú zálohované, a mohli ich nahrať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos prikazuje fotografije v tej napravi skupaj s fotografijami v strežniku Immich, da lahko vidite, katere še niso varnostno kopirane, in jih naložite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos visar bilderna på den här enheten tillsammans med dem på din Immich-server, så att du kan se vilka som inte har säkerhetskopierats än och ladda upp dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos แสดงรูปภาพบนอุปกรณ์นี้พร้อมกับรูปภาพบนเซิร์ฟเวอร์ Immich เพื่อให้คุณดูได้ว่ารูปใดยังไม่ได้สำรองข้อมูลและอัปโหลดรูปเหล่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos, bu aygıttaki fotoğrafları Immich sunucunuzdakilerle birlikte gösterir; böylece henüz yedeklenmemiş olanları görüp yükleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos показує фотографії на цьому пристрої разом із фотографіями на сервері Immich, щоб ви могли побачити, які ще не збережено в резервній копії, і завантажити їх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos hiển thị ảnh trên thiết bị này cùng với ảnh trên máy chủ Immich để bạn biết ảnh nào chưa được sao lưu và tải chúng lên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos 会同时显示此设备和 Immich 服务器上的照片，以便你查看哪些照片尚未备份并上传它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SelfPhotos 會同時顯示此裝置和 Immich 伺服器上的照片，讓你查看哪些照片尚未備份並上傳它們。"
          }
        }
      }
