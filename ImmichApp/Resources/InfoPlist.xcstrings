    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Explains the optional Center on Me action. Browsing photo locations does not require device location access.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Immi موقعك فقط عندما تختار توسيط خريطة الصور حولك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi използва местоположението ви само когато изберете да центрирате картата със снимки около вас."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি ছবির মানচিত্রটি আপনার অবস্থানকে কেন্দ্র করে দেখার বিকল্প বেছে নিলেই Immi আপনার অবস্থান ব্যবহার করে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi només utilitza la teva ubicació quan tries centrar el mapa de fotos al teu voltant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi používá vaši polohu jen tehdy, když zvolíte vycentrování mapy fotek kolem sebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi bruger kun din lokalitet, når du vælger at centrere fotokortet omkring dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi verwendet deinen Standort nur, wenn du die Fotokarte auf deinen Standort zentrierst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Immi χρησιμοποιεί την τοποθεσία σας μόνο όταν επιλέγετε να κεντράρετε τον χάρτη φωτογραφιών γύρω σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi uses your location only when you choose to center the photo map around you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi solo usa tu ubicación cuando eliges centrar el mapa de fotos a tu alrededor."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi فقط وقتی از موقعیت مکانی شما استفاده می‌کند که بخواهید نقشهٔ عکس‌ها روی موقعیت شما متمرکز شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi käyttää sijaintiasi vain, kun valitset sijaintisi kuvakartan keskipisteeksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi utilise votre position uniquement lorsque vous choisissez de centrer la carte des photos autour de vous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi משתמשת במיקום שלכם רק כשאתם בוחרים למרכז את מפת התמונות סביבכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi आपके स्थान का उपयोग केवल तब करता है जब आप फ़ोटो के नक़्शे को अपने स्थान के आसपास केंद्रित करने का विकल्प चुनते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi koristi vašu lokaciju samo kada odaberete centriranje karte fotografija oko sebe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Immi csak akkor használja a helyzetét, ha azt választja, hogy a fotótérkép közepén az aktuális tartózkodási helye jelenjen meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi hanya menggunakan lokasi Anda saat Anda memilih untuk memusatkan peta foto di sekitar Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi usa la tua posizione solo quando scegli di centrare la mappa delle foto intorno a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immiは、写真のマップを現在地の周辺に表示するよう選択した場合にのみ、位置情報を使用します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi фотосуреттер картасын орналасқан жеріңізге қатысты көрсетуді таңдағанда ғана геолокацияңызды пайдаланады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immi는 사진 지도를 사용자의 위치 중심으로 표시하도록 선택한 경우에만 사용자의 위치를 사용합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
