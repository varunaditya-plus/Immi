        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप > विवरण देखें में विफल अपलोड को पुनः प्रयास करने या हटाने के लिए SelfPhotos खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite SelfPhotos za ponovni pokušaj ili uklanjanje neuspjelih prijenosa u Backup > View Details."
