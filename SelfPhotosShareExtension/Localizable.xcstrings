          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich 服务器返回了无效响应。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Server Immich vrátil neplatnú odpoveď."
          }
        },
        "sl": {
