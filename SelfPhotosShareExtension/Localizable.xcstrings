    "No supported images were shared.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada gambar yang didukung yang dibagikan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم مشاركة صور مدعومة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমর্থিত কোনো ছবি শেয়ার করা হয়নি।"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не бяха споделени поддържани изображения."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha compartit cap imatge compatible."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije podijeljena nijedna podržana slika."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyly sdíleny žádné podporované obrázky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke delt nogen understøttede billeder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen ondersteunde afbeeldingen gedeeld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuettuja kuvia ei jaettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune image prise en charge n’a été partagée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden keine unterstützten Bilder geteilt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν κοινοποιήθηκαν υποστηριζόμενες εικόνες."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא שותפו תמונות נתמכות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई समर्थित इमेज साझा नहीं की गई।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem osztottak meg támogatott képeket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stata condivisa alcuna immagine supportata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応している画像が共有されていません。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолдау көрсетілетін суреттер бөлісілмеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 이미지가 공유되지 않았습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebuvo bendrinami jokie palaikomi vaizdai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada imej yang disokong telah dikongsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
