    "The Immich server returned an invalid response.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server Immich mengembalikan respons yang tidak valid."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد خادم Immich استجابة غير صالحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich সার্ভার একটি অবৈধ প্রতিক্রিয়া দিয়েছে।"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich сървърът върна невалиден отговор."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor Immich ha retornat una resposta no vàlida."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich poslužitelj vratio je nevažeći odgovor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server Immich vrátil neplatnou odpověď."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich-serveren returnerede et ugyldigt svar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Immich-server heeft een ongeldig antwoord geretourneerd."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich-palvelin palautti virheellisen vastauksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur Immich a renvoyé une réponse non valide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Immich-Server hat eine ungültige Antwort zurückgegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής Immich επέστρεψε μη έγκυρη απόκριση."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרת Immich החזיר תגובה לא תקינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich सर्वर ने अमान्य प्रतिक्रिया दी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Immich-szerver érvénytelen választ adott."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server Immich ha restituito una risposta non valida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Immichサーバーから無効な応答が返されました。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich сервері жарамсыз жауап қайтарды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich 서버가 올바르지 않은 응답을 반환했습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich serveris pateikė netinkamą atsakymą."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan Immich mengembalikan respons yang tidak sah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Immich-serveren returnerte et ugyldig svar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور Immich پاسخ نامعتبری برگرداند."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer Immich zwrócił nieprawidłową odpowiedź."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor Immich devolveu uma resposta inválida."
          }
        },
        "ro": {
