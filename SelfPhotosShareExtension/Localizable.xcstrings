          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklemeden önce SelfPhotos'u açın ve oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед вивантаженням відкрийте SelfPhotos і ввійдіть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở SelfPhotos và đăng nhập trước khi tải lên."
          }
