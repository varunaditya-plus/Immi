        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri SelfPhotos ed esegui l'accesso prima di caricare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードする前にSelfPhotosを開いてサインインしてください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүктеп салмас бұрын SelfPhotos қолданбасын ашып, жүйеге кіріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드하기 전에 SelfPhotos를 열고 로그인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš įkeldami atidarykite SelfPhotos ir prisijunkite."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka SelfPhotos dan log masuk sebelum memuat naik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne SelfPhotos og logg på før opplasting."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از بارگذاری، SelfPhotos را باز کنید و وارد شوید."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed przesłaniem otwórz SelfPhotos i zaloguj się."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o SelfPhotos e inicie sessão antes de enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți SelfPhotos și autentificați-vă înainte de încărcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте SelfPhotos и войдите перед загрузкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传前请打开 SelfPhotos 并登录。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred nahrávaním otvorte SelfPhotos a prihláste sa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred nalaganjem odprite SelfPhotos in se prijavite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre SelfPhotos e inicia sesión antes de subir archivos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna SelfPhotos och logga in innan du laddar upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด SelfPhotos และเข้าสู่ระบบก่อนอัปโหลด"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
