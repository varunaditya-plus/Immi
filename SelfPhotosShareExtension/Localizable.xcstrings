    "Open SelfPhotos and sign in before uploading.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka SelfPhotos dan masuk sebelum mengunggah."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح SelfPhotos وسجّل الدخول قبل الرفع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপলোডের আগে SelfPhotos খুলে সাইন ইন করুন।"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете SelfPhotos и влезте преди качване."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre SelfPhotos i inicia sessió abans de pujar contingut."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite SelfPhotos i prijavite se prije prijenosa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před nahráváním otevřete SelfPhotos a přihlaste se."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn SelfPhotos, og log ind før upload."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open SelfPhotos en meld je aan voordat je uploadt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa SelfPhotos ja kirjaudu sisään ennen lataamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez SelfPhotos et connectez-vous avant l’envoi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne SelfPhotos und melde dich vor dem Hochladen an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
