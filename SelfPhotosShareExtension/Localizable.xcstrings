    "SelfPhotos could not access its shared upload storage.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos tidak dapat mengakses penyimpanan unggahan bersamanya."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على SelfPhotos الوصول إلى مساحة تخزين الرفع المشتركة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos তার শেয়ার করা আপলোড স্টোরেজে অ্যাক্সেস করতে পারেনি।"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos не можа да получи достъп до споделеното си хранилище за качване."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos no ha pogut accedir al seu espai d'emmagatzematge compartit per a pujades."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos nije mogao pristupiti zajedničkom prostoru za prijenos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos nemá přístup ke sdílenému úložišti pro nahrávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos kunne ikke få adgang til det delte uploadlager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos heeft geen toegang tot de gedeelde uploadopslag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos ei saanut yhteyttä jaettuun lataustallennustilaansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos n’a pas pu accéder à son espace de stockage partagé pour les envois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos konnte nicht auf den gemeinsamen Upload-Speicher zugreifen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το SelfPhotos δεν μπόρεσε να αποκτήσει πρόσβαση στον κοινόχρηστο χώρο μεταφορτώσεων."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos לא הצליח לגשת לאחסון ההעלאות המשותף שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos अपने साझा अपलोड स्टोरेज को एक्सेस नहीं कर सका।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A SelfPhotos nem tudott hozzáférni a megosztott feltöltési tárhelyéhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos non è riuscito ad accedere allo spazio condiviso per i caricamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotosは共有アップロードストレージにアクセスできませんでした。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos ортақ жүктеп салу жадына қатынай алмады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos가 공유 업로드 저장 공간에 접근할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos nepavyko pasiekti bendrinamos įkėlimo saugyklos."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos tidak dapat mengakses storan muat naik kongsinya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos fikk ikke tilgang til den delte opplastingslagringen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos نتوانست به فضای ذخیره‌سازی مشترک بارگذاری دسترسی پیدا کند."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos nie może uzyskać dostępu do współdzielonej przestrzeni przesyłania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O SelfPhotos não conseguiu aceder ao armazenamento partilhado de envios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos nu a putut accesa spațiul de stocare partajat pentru încărcări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos не удалось получить доступ к общему хранилищу загрузок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos 无法访问其共享上传存储空间。"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos nemá prístup k zdieľanému úložisku nahrávania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos ni mogel dostopati do deljenega prostora za nalaganje."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos no ha podido acceder al almacenamiento compartido de cargas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos kunde inte komma åt det delade uppladdningsutrymmet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos ไม่สามารถเข้าถึงพื้นที่จัดเก็บข้อมูลการอัปโหลดที่แชร์ได้"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos 無法取用其共享上傳儲存空間。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos, paylaşılan yükleme depolama alanına erişemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos не вдалося отримати доступ до спільного сховища вивантажень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SelfPhotos không thể truy cập bộ nhớ tải lên dùng chung."
          }
        }
      }
    },
